<script server>
/* The match-type options are a fixed list from the model's own enum, so they
 * are rendered here rather than looped in the browser: the select is usable in
 * the first paint and there is nothing for hydration to rebuild. */
import { SEGMENT_MATCH_TYPES } from '../../data/segments-query'

export const matchOptions = SEGMENT_MATCH_TYPES
</script>

<script client>
/**
 * The segments workspace, reading the application's own API.
 *
 * This page was one of seventeen areas of `WorkspaceSurface`, which holds its
 * figures as literals: 18 active segments, 24,816 marketable people, a last
 * evaluation two minutes ago, and three named segments with sizes. This
 * workspace has none of those. Everything below comes from
 * `GET /api/v1/segments`, which `Segment`'s `useApi` trait already published
 * behind the `auth` and `team` middleware and which the auto-CRUD layer scopes
 * to the caller's team. No team id is sent from the browser.
 *
 * What the page does not show is as deliberate as what it does. There is no
 * evaluator in this application yet, so a segment has a size only once its
 * `refreshed_at` says an evaluation happened; until then the size column reads
 * "Not evaluated yet". And there is no search box, because the endpoint
 * searches the model's `useSearch` fields and `Segment` declares none.
 *
 * Writes carry the CSRF token explicitly, as the audience page does: the
 * middleware is a stateless double-submit, the first listing below is the safe
 * response that sets the cookie, and it is read with `useCookie`, the
 * composable, since a client script may not reach for the DOM itself.
 */
import {
  draftError,
  listErrorMessage,
  saveErrorMessage,
  segmentPayload,
  SEGMENTS_ENDPOINT,
  SEGMENTS_PER_PAGE,
  segmentsUrl,
  toSegmentViews,
} from '../../data/segments-query'

const segments = state([])
const total = state(null)
const hasMore = state(false)
const page = state(1)
const loading = state(true)
const errorText = state('')
/* Which control the in-flight load belongs to, so one busy state is announced
 * rather than three. */
const busySource = state('refresh')

const addOpen = state(false)
const addName = state('')
const addDescription = state('')
const addMatchType = state('all')
const saving = state(false)
const addError = state('')

const csrfToken = useCookie('X-CSRF-Token')

const refreshBusy = derived(() => loading() && busySource() === 'refresh')
const prevBusy = derived(() => loading() && busySource() === 'prev')
const nextBusy = derived(() => loading() && busySource() === 'next')
const showEmpty = derived(() => !loading() && !errorText() && segments().length === 0)
const showTable = derived(() => !loading() && !errorText() && segments().length > 0)
/* Says what is on screen, and the workspace total only when the paginator
 * supplied one. */
const countLabel = derived(() => {
  const shown = segments().length
  const all = total()
  if (typeof all === 'number')
    return `${shown} of ${all}`
  return String(shown)
})

async function load(source = 'refresh') {
  busySource.set(source)
  loading.set(true)
  errorText.set('')
  try {
    const response = await fetch(segmentsUrl({ page: page(), perPage: SEGMENTS_PER_PAGE }), {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    })

    if (!response.ok) {
      errorText.set(listErrorMessage(response.status))
      segments.set([])
      return
    }

    const body = await response.json()
    segments.set(toSegmentViews(body))
    total.set(typeof body?.total === 'number' ? body.total : null)
    hasMore.set(body?.has_more_pages === true)
  }
  catch {
    // A network failure, not a refusal: there is no status to explain.
    errorText.set('Segments could not be loaded. Check your connection and try again.')
    segments.set([])
  }
  finally {
    loading.set(false)
  }
}

function nextPage() {
  if (!hasMore() || loading())
    return
  page.update(value => value + 1)
  void load('next')
}

function previousPage() {
  if (page() <= 1 || loading())
    return
  page.update(value => value - 1)
  void load('prev')
}

function toggleAdd() {
  addOpen.update(value => !value)
  addError.set('')
}

async function addSegment() {
  const draft = { name: addName(), description: addDescription(), matchType: addMatchType() }
  const problem = draftError(draft)
  if (problem) {
    addError.set(problem)
    return
  }

  saving.set(true)
  addError.set('')
  try {
    const response = await fetch(SEGMENTS_ENDPOINT, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken() || '',
      },
      body: JSON.stringify(segmentPayload(draft)),
    })

    if (response.status === 201 || response.ok) {
      addName.set('')
      addDescription.set('')
      addMatchType.set('all')
      addOpen.set(false)
      page.set(1)
      await load()
      return
    }

    addError.set(saveErrorMessage(response.status))
  }
  catch {
    addError.set('The segment could not be saved. Check your connection and try again.')
  }
  finally {
    saving.set(false)
  }
}

onMount(() => {
  void load()
})
</script>

<main id="main" class="p-5 sm:p-8 min-h-screen text-fg bg-page">
  <div class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-7">
      <div>
        <p class="font-bold text-[11px] text-accent tracking-[0.2em] uppercase">Segments</p>
        <h1 class="mt-2 font-semibold text-4xl tracking-[-0.04em]">Find the people behind the pattern.</h1>
        <p class="mt-2 max-w-2xl text-fg-muted text-sm">Named groups of contacts, each defined by its own rules. A segment has no size until it has been evaluated, so a new one says so rather than guessing.</p>
      </div>
      <div class="flex gap-2">
        <button type="button" @click="load()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Refresh</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Create segment</button>
      </div>
    </header>

    <section :if="addOpen()" class="mb-5 p-5 bg-panel border border-line rounded-panel" aria-labelledby="add-segment-title">
      <h2 id="add-segment-title" class="font-bold text-sm">Create a segment</h2>
      <p class="mt-1 text-fg-muted text-xs">It starts with no rules and no size. Nothing can be sent to a segment until it has rules to match contacts against.</p>
      <div class="grid gap-3 sm:grid-cols-3 mt-4">
        <label class="block font-bold text-xs">
          Name
          <input x-model.trim="addName" type="text" autocomplete="off" maxlength="120" class="mt-1 field" placeholder="Engaged readers">
        </label>
        <label class="block font-bold text-xs">
          Description
          <input x-model.trim="addDescription" type="text" autocomplete="off" maxlength="500" class="mt-1 field">
        </label>
        <label class="block font-bold text-xs">
          A contact must match
          <select x-model="addMatchType" class="mt-1 field">
            @foreach(matchOptions as option)
              <option value="{{ option.value }}">{{ option.label }}</option>
            @endforeach
          </select>
        </label>
      </div>
      <p :if="addError()" class="mt-3 font-bold text-danger text-xs" role="alert">{{ addError() }}</p>
      <div class="flex gap-2 mt-4">
        <button type="button" @click="addSegment()" :disabled="saving()" :aria-busy="saving()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Save segment</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Cancel</button>
      </div>
    </section>

    <section class="overflow-hidden bg-panel border border-line rounded-panel" aria-labelledby="segments-title">
      <div class="p-5 border-b border-line">
        <h2 id="segments-title" class="font-bold">Segments</h2>
        <p class="text-fg-muted text-xs">Showing {{ countLabel() }}</p>
      </div>

      {{-- Loading. A row-shaped skeleton rather than a spinner, so the table
           does not jump height when the rows land. --}}
      <div :if="loading()" class="p-5 space-y-3" aria-hidden="true">
        <div class="h-10 bg-surface-sunken rounded-control"></div>
        <div class="h-10 bg-surface-sunken rounded-control"></div>
        <div class="h-10 bg-surface-sunken rounded-control"></div>
      </div>
      <p :if="loading()" class="sr-only" role="status">Loading segments</p>

      <div :if="errorText()" class="p-8 text-center" role="alert">
        <span aria-hidden="true" class="inline-block h-6 w-6 text-danger i-hugeicons-alert-02"></span>
        <p class="mt-3 font-bold text-sm">{{ errorText() }}</p>
        <button type="button" @click="load()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="mt-4 px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-60">Try again</button>
      </div>

      <div :if="showEmpty()" class="p-10 text-center">
        <span aria-hidden="true" class="inline-block h-7 w-7 text-fg-muted i-hugeicons-filter-horizontal"></span>
        <p class="mt-3 font-bold">This workspace has no segments yet.</p>
        <p class="mt-1 text-fg-muted text-sm">Create the first one to start grouping contacts by what they have in common.</p>
      </div>

      {{-- Phone: one card per segment. The table below carries four columns,
           which cannot be read at 390px without horizontal scrolling. --}}
      <div :if="showTable()" class="sm:hidden divide-line divide-y">
        <template :for="segment in segments()">
          <article class="p-5">
            <h3 class="font-bold text-sm">{{ segment.name }}</h3>
            <p :if="segment.description" class="mt-0.5 text-fg-muted text-xs">{{ segment.description }}</p>
            <dl class="grid gap-3 grid-cols-2 mt-4 text-xs">
              <div>
                <dt class="text-fg-muted">Matching</dt>
                <dd class="mt-1 font-medium">{{ segment.matchLabel }}</dd>
              </div>
              <div>
                <dt class="text-fg-muted">Size</dt>
                <dd class="mt-1 font-medium">{{ segment.sizeLabel }}</dd>
              </div>
              <div class="col-span-2">
                <dt class="text-fg-muted">Last evaluated</dt>
                <dd class="mt-1 font-medium">{{ segment.refreshedLabel }}</dd>
              </div>
            </dl>
          </article>
        </template>
      </div>

      <div :if="showTable()" class="hidden sm:block overflow-x-auto">
        <table class="min-w-[760px] w-full text-left">
          <caption class="sr-only">Segments in this workspace</caption>
          <thead class="text-[10px] text-fg-muted tracking-[0.14em] uppercase bg-surface-sunken">
            <tr>
              <th scope="col" class="px-5 py-3">Segment</th>
              <th scope="col" class="px-5 py-3">Matching</th>
              <th scope="col" class="px-5 py-3">Size</th>
              <th scope="col" class="px-5 py-3">Last evaluated</th>
            </tr>
          </thead>
          <tbody>
            <template :for="segment in segments()">
              <tr class="hover:bg-surface-hover border-line border-t">
                <td class="px-5 py-4">
                  <p class="font-bold text-sm">{{ segment.name }}</p>
                  <p :if="segment.description" class="mt-0.5 text-fg-muted text-xs">{{ segment.description }}</p>
                </td>
                <td class="px-5 py-4 text-sm">{{ segment.matchLabel }}</td>
                <td class="px-5 py-4 text-sm">{{ segment.sizeLabel }}</td>
                <td class="px-5 py-4 text-sm">{{ segment.refreshedLabel }}</td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <div :if="showTable()" class="flex items-center justify-between p-4 border-line border-t">
        <p class="m-0 text-fg-muted text-xs">Page {{ page() }}</p>
        <div class="flex gap-2">
          <button type="button" @click="previousPage()" :disabled="page() <= 1 || prevBusy()" :aria-busy="prevBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Previous</button>
          <button type="button" @click="nextPage()" :disabled="!hasMore() || nextBusy()" :aria-busy="nextBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Next</button>
        </div>
      </div>
    </section>
  </div>
</main>
