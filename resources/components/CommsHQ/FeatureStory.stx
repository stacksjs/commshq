<script server>
interface FeatureStoryProps { feature?: string }
interface FeaturePage {
  eyebrow: string
  title: string
  intro: string
  promise: string
  icon: string
  metrics: Array<{ value: string, label: string }>
  capabilities: Array<{ title: string, text: string, icon: string }>
  steps: Array<{ number: string, title: string, text: string }>
}

const props = defineProps<FeatureStoryProps>()
const pages: Record<string, FeaturePage> = {
  audience: {
    eyebrow: 'Audience intelligence', title: 'Know the person, not just the address.', intro: 'Bring identities, preferences, behavior, purchases, and consent proof into one workspace-scoped audience record.', promise: 'Every segment stays explainable, every suppression wins, and every team sees only its own people.', icon: 'i-hugeicons-user-group',
    metrics: [{ value: '1 profile', label: 'across every channel' }, { value: '100%', label: 'suppression precedence' }, { value: '< 2 min', label: 'typical segment refresh' }],
    capabilities: [{ title: 'Unified profiles', text: 'Resolve email, phone, publication, and commerce identities without losing source history.', icon: 'i-hugeicons-contact-01' }, { title: 'Dynamic segments', text: 'Combine consent, engagement, properties, referrals, and purchases in readable rules.', icon: 'i-hugeicons-filter-horizontal' }, { title: 'Consent ledger', text: 'Keep append-only proof of purpose, policy, channel, jurisdiction, source, and time.', icon: 'i-hugeicons-shield-02' }, { title: 'Safe imports', text: 'Map fields, preview changes, deduplicate records, and preserve suppression on every import.', icon: 'i-hugeicons-file-import' }, { title: 'Preference center', text: 'Let people choose topics and channels without forcing an all-or-nothing unsubscribe.', icon: 'i-hugeicons-settings-02' }, { title: 'Portable data', text: 'Run accountable exports, erasure requests, retention rules, and merge history.', icon: 'i-hugeicons-database-export' }],
    steps: [{ number: '01', title: 'Collect with context', text: 'Forms, APIs, imports, and events retain their source and declared purpose.' }, { number: '02', title: 'Resolve and segment', text: 'Identity and rule evaluation build a current, inspectable audience view.' }, { number: '03', title: 'Activate safely', text: 'Channel consent and suppression are checked again at the moment of delivery.' }],
  },
  forms: {
    eyebrow: 'Forms and conversion', title: 'Make every signup feel like an invitation.', intro: 'Create fast forms, focused landing pages, link pages, and gated resources that capture meaningful consent.', promise: 'Publish on a CommsHQ site or embed anywhere, with accessible defaults and clear conversion diagnostics.', icon: 'i-hugeicons-note-add',
    metrics: [{ value: 'AA', label: 'accessible interaction target' }, { value: '1 proof', label: 'attached to every consent' }, { value: '0 scripts', label: 'required for core submission' }],
    capabilities: [{ title: 'Flexible forms', text: 'Collect standard and custom fields with validation, progressive disclosure, and useful errors.', icon: 'i-hugeicons-form' }, { title: 'Landing pages', text: 'Compose focused pages from reusable sections with responsive previews.', icon: 'i-hugeicons-web-design-02' }, { title: 'Double opt-in', text: 'Send signed confirmations with expiration, replay protection, and policy provenance.', icon: 'i-hugeicons-mail-validation-01' }, { title: 'Gated resources', text: 'Deliver files and premium resources only after the required confirmation.', icon: 'i-hugeicons-lock-key' }, { title: 'Source attribution', text: 'Carry campaign, referral, page, and form context into the contact record.', icon: 'i-hugeicons-source-code' }, { title: 'Conversion diagnostics', text: 'Inspect views, starts, completions, confirmation, and field-level friction.', icon: 'i-hugeicons-chart-evaluation' }],
    steps: [{ number: '01', title: 'Compose', text: 'Choose fields, consent language, success behavior, and a visual treatment.' }, { number: '02', title: 'Publish', text: 'Use a native page, custom domain, embed, or signed public endpoint.' }, { number: '03', title: 'Learn', text: 'Trace confirmed signups to their source and improve the point of friction.' }],
  },
  analytics: {
    eyebrow: 'First-party analytics', title: 'See what attention becomes.', intro: 'Follow the path from acquisition to engagement, purchase, referral, renewal, and lifetime value without selling audience data.', promise: 'Reports share one event vocabulary, so campaign and commerce numbers reconcile instead of competing.', icon: 'i-hugeicons-chart-line-data-02',
    metrics: [{ value: '1 ledger', label: 'for channel and commerce events' }, { value: '0 pixels', label: 'sold to ad networks' }, { value: 'Real time', label: 'journey diagnostics' }],
    capabilities: [{ title: 'Growth sources', text: 'Compare forms, referrals, recommendations, organic visits, and integrations.', icon: 'i-hugeicons-analytics-up' }, { title: 'Campaign performance', text: 'Measure delivery, engagement, experiments, conversion, and downstream revenue.', icon: 'i-hugeicons-mail-open-01' }, { title: 'Journey funnels', text: 'See where automation runs advance, wait, branch, fail, and convert.', icon: 'i-hugeicons-flowchart-01' }, { title: 'Revenue attribution', text: 'Connect products, carts, orders, subscriptions, and offers to the messages that helped.', icon: 'i-hugeicons-money-03' }, { title: 'Cohorts and retention', text: 'Compare reader and customer behavior by acquisition date, source, and first action.', icon: 'i-hugeicons-calendar-03' }, { title: 'Trusted exports', text: 'Export scoped data with permissions, audit events, and stable definitions.', icon: 'i-hugeicons-download-04' }],
    steps: [{ number: '01', title: 'Capture', text: 'Immutable events enter through signed, deduplicated first-party surfaces.' }, { number: '02', title: 'Attribute', text: 'Known identities and declared models connect activity to outcomes.' }, { number: '03', title: 'Act', text: 'Turn a finding into a segment, experiment, or journey without exporting a list.' }],
  },
  monetization: {
    eyebrow: 'Creator monetization', title: 'Earn without spending reader trust.', intro: 'Run paid publications, digital products, referrals, recommendations, sponsorships, inventory, commissions, and payouts together.', promise: 'Every fee, placement, disclosure, earning, and approval remains visible from offer to payout.', icon: 'i-hugeicons-money-receive-circle',
    metrics: [{ value: '0%', label: 'fee on connected-store sales' }, { value: '10%', label: 'network fee, clearly stated' }, { value: '1 ledger', label: 'for earnings and commissions' }],
    capabilities: [{ title: 'Paid publications', text: 'Offer member access, protected posts, trials, and plan-aware lifecycle messages.', icon: 'i-hugeicons-crown' }, { title: 'Digital products', text: 'Sell owned downloads and resources through native Stacks Commerce.', icon: 'i-hugeicons-package' }, { title: 'Referral programs', text: 'Define milestones, rewards, fraud review, and fulfillment with clear status.', icon: 'i-hugeicons-share-08' }, { title: 'Recommendations', text: 'Build accountable exchanges with consent-aware attribution and commission rules.', icon: 'i-hugeicons-user-love-01' }, { title: 'Sponsor inventory', text: 'Manage offers, audience fit, disclosures, placements, approvals, and reporting.', icon: 'i-hugeicons-megaphone-02' }, { title: 'Payout accounting', text: 'Keep append-only earnings, commissions, adjustments, and reviewed payouts.', icon: 'i-hugeicons-bank' }],
    steps: [{ number: '01', title: 'Choose the model', text: 'Paid access, a product, a referral reward, or a sponsor placement.' }, { number: '02', title: 'Set the terms', text: 'Define eligibility, pricing, fees, disclosures, approval, and fulfillment.' }, { number: '03', title: 'Reconcile', text: 'Follow attributed earnings into an audited payout without spreadsheet gaps.' }],
  },
  ai: {
    eyebrow: 'Responsible AI assistance', title: 'Move faster and keep the final say.', intro: 'Use AWS Bedrock through the Stacks AI driver for writing, segmentation, summaries, and optimization inside the workflow.', promise: 'Workspace quotas, stored provenance, audit events, and human approval keep assistance accountable.', icon: 'i-hugeicons-ai-innovation-01',
    metrics: [{ value: '100%', label: 'human approval before send' }, { value: '1 quota', label: 'per workspace and plan' }, { value: 'Full', label: 'prompt and output provenance' }],
    capabilities: [{ title: 'Writing partner', text: 'Draft subjects, message sections, summaries, and variants from approved context.', icon: 'i-hugeicons-pencil-edit-02' }, { title: 'Segment assistant', text: 'Translate an audience idea into inspectable rules that a person confirms.', icon: 'i-hugeicons-filter-edit' }, { title: 'Content summaries', text: 'Turn owned posts, feeds, and product updates into review-ready briefs.', icon: 'i-hugeicons-text' }, { title: 'Experiment ideas', text: 'Propose declared hypotheses, variants, and winning metrics before allocation.', icon: 'i-hugeicons-flask' }, { title: 'Workspace controls', text: 'Enforce plan limits, team permissions, usage metering, and cost reporting.', icon: 'i-hugeicons-dashboard-square-setting' }, { title: 'Provenance trail', text: 'Store model, inputs, output, reviewer, decision, and the published revision.', icon: 'i-hugeicons-audit-01' }],
    steps: [{ number: '01', title: 'Ask with context', text: 'Choose only the workspace material relevant to the task.' }, { number: '02', title: 'Review the result', text: 'Edit the draft and inspect provenance, usage, and policy warnings.' }, { number: '03', title: 'Approve explicitly', text: 'A permitted person confirms the final content before publish or send.' }],
  },
  deliverability: {
    eyebrow: 'Deliverability', title: 'Protect the trust behind every send.', intro: 'Verify senders, authenticate domains, classify delivery outcomes, and keep suppression synchronized across campaigns and retries.', promise: 'The owned mail service and channel-neutral delivery ledger make reputation health understandable and enforceable.', icon: 'i-hugeicons-mail-validation-01',
    metrics: [{ value: 'SPF + DKIM', label: 'verified sender alignment' }, { value: '< 0.1%', label: 'complaint alert target' }, { value: 'Never', label: 'resend after suppression' }],
    capabilities: [{ title: 'Sender domains', text: 'Guide customers through SPF and DKIM verification without exposing server administration.', icon: 'i-hugeicons-global' }, { title: 'Reputation view', text: 'Track bounces, complaints, deferrals, blocks, and engagement by sender.', icon: 'i-hugeicons-activity-03' }, { title: 'Suppression first', text: 'Apply complaints, hard bounces, unsubscribes, and policy blocks before every attempt.', icon: 'i-hugeicons-user-block-01' }, { title: 'Delivery events', text: 'Deduplicate provider callbacks into a normalized, searchable event history.', icon: 'i-hugeicons-route-03' }, { title: 'Retry classification', text: 'Separate temporary provider failures from permanent recipient failures.', icon: 'i-hugeicons-refresh' }, { title: 'Health checks', text: 'Validate SMTP, mailboxes, DNS, TLS, queues, webhooks, and feedback processing.', icon: 'i-hugeicons-pulse-01' }],
    steps: [{ number: '01', title: 'Authenticate', text: 'Verify the sending identity and aligned domain records.' }, { number: '02', title: 'Send deliberately', text: 'Respect consent, suppression, rate limits, and reputation thresholds.' }, { number: '03', title: 'Respond to feedback', text: 'Classify events, suppress immediately, and surface actions to the team.' }],
  },
}
const page = pages[props.feature || 'audience'] || pages.audience
</script>

<section class="editorial-grid border-b border-tone">
  <div class="mx-auto max-w-7xl grid min-h-[620px] items-center gap-12 px-5 py-20 lg:grid-cols-[1fr_0.8fr] lg:px-8 lg:py-28">
    <div>
      <p class="coral mb-5 text-xs font-bold uppercase tracking-[0.22em]">{{ page.eyebrow }}</p>
      <h1 class="ink text-balance m-0 max-w-4xl text-5xl leading-[0.98] tracking-[-0.045em] sm:text-7xl">{{ page.title }}</h1>
      <p class="muted mt-7 max-w-2xl text-lg leading-8">{{ page.intro }}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href="/dashboard/register" class="bg-coral inline-flex min-h-12 items-center justify-center rounded-md px-6 font-bold text-white">Start free</a><a href="/features" class="ink panel inline-flex min-h-12 items-center justify-center gap-2 rounded-md border border-tone px-6 font-bold">All features<span class="i-hugeicons-arrow-right-02 h-4 w-4" aria-hidden="true"></span></a></div>
    </div>
    <aside class="panel relative overflow-hidden rounded-[2rem] border border-tone p-8 shadow-[0_28px_80px_rgba(32,29,26,0.12)] sm:p-10">
      <span class="coral {{ page.icon }} h-10 w-10" aria-hidden="true"></span>
      <p class="ink mt-20 text-balance text-2xl font-semibold leading-9">{{ page.promise }}</p>
      <div class="mt-10 h-1 w-20 rounded-full bg-coral" aria-hidden="true"></div>
    </aside>
  </div>
</section>

<section aria-label="Feature outcomes" class="border-b border-tone">
  <div class="mx-auto max-w-7xl grid divide-y divide-tone px-5 md:grid-cols-3 md:divide-x md:divide-y-0 lg:px-8">
    @foreach(page.metrics as metric)
      <div class="py-8 md:px-8 md:first:pl-0"><p class="ink m-0 text-3xl font-bold">{{ metric.value }}</p><p class="muted mb-0 mt-1 text-sm">{{ metric.label }}</p></div>
    @endforeach
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
  <div class="max-w-3xl"><p class="coral text-xs font-bold uppercase tracking-[0.22em]">Built into the platform</p><h2 class="ink text-balance mt-4 text-4xl leading-tight tracking-[-0.035em] sm:text-5xl">The details are part of the product.</h2></div>
  <div class="mt-14 grid gap-px overflow-hidden rounded-xl border border-tone bg-[var(--line)] md:grid-cols-2 lg:grid-cols-3">
    @foreach(page.capabilities as capability)
      <article class="paper min-h-64 p-8"><span class="coral {{ capability.icon }} h-6 w-6" aria-hidden="true"></span><h3 class="ink mt-10 text-2xl">{{ capability.title }}</h3><p class="muted mb-0 mt-3 leading-7">{{ capability.text }}</p></article>
    @endforeach
  </div>
</section>

<section class="panel border-y border-tone py-24 lg:py-32">
  <div class="mx-auto max-w-7xl grid gap-12 px-5 lg:grid-cols-[0.65fr_1.35fr] lg:px-8">
    <div><p class="coral text-xs font-bold uppercase tracking-[0.22em]">How it works</p><h2 class="ink text-balance mt-4 text-4xl leading-tight tracking-[-0.035em] sm:text-5xl">A clear path from signal to action.</h2></div>
    <ol class="m-0 space-y-3 p-0">
      @foreach(page.steps as step)
        <li class="paper grid gap-5 rounded-xl border border-tone p-7 sm:grid-cols-[auto_1fr]"><span class="coral font-bold">{{ step.number }}</span><div><h3 class="ink m-0 text-2xl">{{ step.title }}</h3><p class="muted mb-0 mt-2 leading-7">{{ step.text }}</p></div></li>
      @endforeach
    </ol>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><div class="bg-coral rounded-xl p-8 text-white sm:p-12"><p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-white/75">Make the next move useful</p><h2 class="text-balance m-0 max-w-3xl text-4xl leading-tight sm:text-5xl">Bring this work into one communications home.</h2><a href="/dashboard/register" class="mt-7 inline-flex min-h-12 items-center rounded-md bg-white px-6 font-bold text-[#c73e2c]">Start with CommsHQ</a></div></section>
