<script client>
/**
 * The command center, reading the application's own API.
 *
 * Every figure on this page used to be a literal in this file: 1,284 new
 * contacts, 84,219 messages delivered, $18,460 attributed revenue, 12 active
 * journeys, a twelve-bar growth chart of invented heights, and four activity
 * entries about orders that were never placed. The endpoint that answers all
 * of it already existed. `routes/api.ts` publishes `GET /api/v1/workspace`
 * behind the `auth` and `team` middleware, and
 * `app/Actions/Api/V1/WorkspaceSummaryAction` was already counting this team's
 * contacts, campaigns, publications, running automations and earnings. Nothing
 * connected the two.
 *
 * Fetched from the browser rather than rendered on the server, which is the
 * pattern the dashboard guidance names and the audience page follows: the
 * document is a shell, the figures arrive after hydration. The auth cookie is
 * HttpOnly and `SameSite=Lax`, so `credentials: 'same-origin'` authenticates
 * this call, and no team id is sent from the browser. Asking for another
 * workspace's numbers is not something this page can express.
 *
 * Read-only, so there is no CSRF token here: the middleware's double-submit
 * check applies to unsafe methods, and this page performs none.
 */
import {
  summaryErrorMessage,
  toCurrentMeters,
  toLibraryEntries,
  toPulseTiles,
  WORKSPACE_ENDPOINT,
  WORKSPACE_FALLBACK_NAME,
  workspaceName,
} from '../../data/workspace-summary'

const summary = state(null)
const loading = state(true)
const errorText = state('')

const displayName = state(WORKSPACE_FALLBACK_NAME)
const tiles = derived(() => toPulseTiles(summary()))
const meters = derived(() => toCurrentMeters(summary()))
const library = derived(() => toLibraryEntries(summary()))

const ready = derived(() => !loading() && !errorText())
const showMeters = derived(() => ready() && meters().length > 0)
const showNoMeters = derived(() => ready() && meters().length === 0)

async function load() {
  loading.set(true)
  errorText.set('')
  try {
    const response = await fetch(WORKSPACE_ENDPOINT, {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    })

    if (!response.ok) {
      errorText.set(summaryErrorMessage(response.status))
      summary.set(null)
      return
    }

    const body = await response.json()
    summary.set(body?.data ?? null)
    displayName.set(workspaceName(body?.data ?? null))
  }
  catch {
    // A network failure, not a refusal: there is no status to explain.
    errorText.set('The workspace summary could not be loaded. Check your connection and try again.')
    summary.set(null)
  }
  finally {
    loading.set(false)
  }
}

onMount(() => {
  void load()
})
</script>

<main id="main" class="px-4 py-5 sm:px-6 lg:px-9 lg:py-8 min-h-screen text-fg bg-page">
  <div class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between pb-7 border-b border-line">
      <div>
        <p class="mb-2 font-bold text-[11px] text-accent tracking-[0.2em] uppercase">{{ displayName() }}</p>
        <h1 class="max-w-3xl font-semibold text-3xl tracking-[-0.04em] sm:text-4xl">What this workspace holds today.</h1>
        <p class="mt-3 max-w-2xl text-fg-muted text-sm">Every figure below is counted from this workspace's own records. Where a number is zero, nothing has been recorded yet.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" @click="load()" :disabled="loading()" :aria-busy="loading()" class="inline-flex gap-2 items-center px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 disabled:opacity-60">
          <span aria-hidden="true" class="h-4 w-4 i-hugeicons-database-sync-01"></span>Refresh
        </button>
        <StxLink to="/dashboard/commshq/campaigns" class="inline-flex gap-2 items-center px-5 min-h-11 font-bold text-accent-ink text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">
          <span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>Create campaign
        </StxLink>
      </div>
    </header>

    <section aria-labelledby="pulse-title" class="py-7">
      <div class="flex items-center justify-between mb-4">
        <h2 id="pulse-title" class="font-bold text-sm">Workspace pulse</h2>
        {{-- Not "Last 30 days", which the old caption claimed. These are
             lifetime counts and one sum over the most recent earnings; there is
             no window in the query for a caption to name. --}}
        <span class="text-fg-muted text-xs">Counted now</span>
      </div>

      <div :if="loading()" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5" aria-hidden="true">
        <div class="h-[8.5rem] bg-surface-sunken border border-line rounded-panel"></div>
        <div class="h-[8.5rem] bg-surface-sunken border border-line rounded-panel"></div>
        <div class="h-[8.5rem] bg-surface-sunken border border-line rounded-panel"></div>
        <div class="h-[8.5rem] bg-surface-sunken border border-line rounded-panel"></div>
        <div class="h-[8.5rem] bg-surface-sunken border border-line rounded-panel"></div>
      </div>
      <p :if="loading()" class="sr-only" role="status">Loading the workspace summary</p>

      <div :if="errorText()" class="p-8 text-center bg-panel border border-line rounded-panel" role="alert">
        <p class="font-bold text-danger text-sm">{{ errorText() }}</p>
        <button type="button" @click="load()" class="mt-4 px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">Try again</button>
      </div>

      <div :if="ready()" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
        <template :for="tile in tiles()">
          <article class="p-5 bg-panel border border-line rounded-panel">
            <span aria-hidden="true" class="grid place-items-center mb-6 h-9 w-9 text-accent bg-accent-soft rounded-pill">
              <span class="h-[18px] w-[18px] {{ tile.icon }}"></span>
            </span>
            <p class="font-semibold text-3xl tracking-[-0.04em]">{{ tile.value }}</p>
            <p class="mt-1 font-medium text-sm">{{ tile.label }}</p>
            <p class="mt-0.5 text-fg-muted text-xs">{{ tile.note }}</p>
          </article>
        </template>
      </div>
    </section>

    <div class="grid gap-5 xl:grid-cols-[1.45fr_0.75fr]">
      <section aria-labelledby="usage-title" class="p-6 sm:p-8 bg-panel border border-line rounded-panel">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between mb-7">
          <div>
            <p class="font-bold text-[11px] text-accent tracking-[0.18em] uppercase">This period</p>
            <h2 id="usage-title" class="mt-2 font-semibold text-2xl tracking-[-0.03em]">Usage against your plan</h2>
          </div>
          {{-- This replaced a twelve-bar "growth line" whose heights were
               twelve numbers typed into this file. The meters are real rows
               from `usage_meters`, so the panel now shows something that can
               be checked. --}}
          <p class="max-w-xs leading-6 text-fg-muted text-sm">Recorded by the meters on this workspace for the period covering today.</p>
        </div>

        <div :if="loading()" class="space-y-4" aria-hidden="true">
          <div class="h-12 bg-surface-sunken rounded-control"></div>
          <div class="h-12 bg-surface-sunken rounded-control"></div>
          <div class="h-12 bg-surface-sunken rounded-control"></div>
        </div>

        <div :if="showMeters()" class="space-y-5">
          <template :for="meter in meters()">
            <div>
              <div class="flex gap-3 items-baseline justify-between">
                <p class="font-medium text-sm">{{ meter.label }}</p>
                <p class="shrink-0 text-fg-muted text-xs"><span class="font-bold text-fg">{{ meter.usedLabel }}</span> {{ meter.allowanceLabel }}</p>
              </div>
              <div :if="meter.percent !== null" class="mt-2 h-1.5 w-full bg-surface-sunken rounded-pill" role="progressbar" aria-valuemin="0" aria-valuemax="100" :aria-valuenow="meter.percent" :aria-label="meter.label">
                <div class="h-1.5 bg-accent rounded-pill" :style="'width: ' + meter.percent + '%'"></div>
              </div>
            </div>
          </template>
        </div>

        <p :if="showNoMeters()" class="text-fg-muted text-sm">No meter covers today, so there is nothing recorded for this period yet.</p>
      </section>

      <section aria-labelledby="library-title" class="p-6 sm:p-7 bg-panel border border-line rounded-panel">
        <div class="flex items-center justify-between mb-5">
          <h2 id="library-title" class="font-semibold text-lg">Your library</h2>
        </div>
        {{-- This replaced a "Live activity" feed of four invented events. There
             is no activity endpoint, and every event table in this workspace is
             empty, so the panel shows what the workspace actually has instead
             of narrating things that never happened. --}}
        <div :if="loading()" class="space-y-2" aria-hidden="true">
          <div class="h-14 bg-surface-sunken rounded-control"></div>
          <div class="h-14 bg-surface-sunken rounded-control"></div>
          <div class="h-14 bg-surface-sunken rounded-control"></div>
        </div>

        <dl :if="ready()" class="divide-line divide-y">
          <template :for="entry in library()">
            <div class="flex gap-3 items-center justify-between py-4">
              <dt class="font-medium text-sm">
                <StxLink :if="entry.href" :to="entry.href" class="text-link hover:underline">{{ entry.label }}</StxLink>
                <span :if="!entry.href" class="text-fg">{{ entry.label }}</span>
              </dt>
              <dd class="font-semibold text-xl tracking-[-0.03em]">{{ entry.countLabel }}</dd>
            </div>
          </template>
        </dl>
      </section>
    </div>
  </div>
</main>
