<script server>
/* Fixed lists from the module, rendered here rather than looped in the
 * browser, so the selects are usable in the first paint. */
import { PUBLICATION_ACCESS, PUBLICATION_STATUSES } from '../../data/publications-query'

export const accessOptions = PUBLICATION_ACCESS
export const statusOptions = PUBLICATION_STATUSES
</script>

<script client>
/**
 * Publications, reading and writing through the application's own API.
 *
 * This page was the `publications` area of `WorkspaceSurface`: 148 published
 * posts, 2,184 paid members, 8,942 feed subscribers and a list of scheduled
 * issues, none of it read from anywhere.
 *
 * It lists publications from `GET /api/v1/publications`, creates them as
 * drafts, and moves them between statuses with a PATCH. A publication here
 * is a named home that members, podcasts and referrals attach to. Nothing
 * is published from this page: the application has no posts and no public
 * route that serves a publication, so the status is a label on the record.
 * The page says so; `publications-query.ts` records the detail.
 *
 * Writes carry the CSRF token explicitly, read with `useCookie`, the
 * composable, since a client script may not reach for the DOM itself.
 */
import {
  draftError,
  listErrorMessage,
  publicationPayload,
  PUBLICATIONS_ENDPOINT,
  PUBLICATIONS_PER_PAGE,
  publicationsUrl,
  publicationUrl,
  saveErrorMessage,
  toPublicationViews,
} from '../../data/publications-query'

const publications = state([])
const hasMore = state(false)
const page = state(1)
const status = state('')
const loading = state(true)
const errorText = state('')
const actionError = state('')
/* Which control the in-flight load belongs to, so one busy state is announced
 * rather than three. */
const busySource = state('refresh')
/* The publication a status change is in flight for, so only its buttons are busy. */
const busyId = state(0)

const addOpen = state(false)
const addName = state('')
const addSlug = state('')
const addAccess = state('free')
const addDescription = state('')
const saving = state(false)
const addError = state('')

const csrfToken = useCookie('X-CSRF-Token')

const refreshBusy = derived(() => loading() && busySource() === 'refresh')
const prevBusy = derived(() => loading() && busySource() === 'prev')
const nextBusy = derived(() => loading() && busySource() === 'next')
const showEmpty = derived(() => !loading() && !errorText() && publications().length === 0)
const showList = derived(() => !loading() && !errorText() && publications().length > 0)

async function load(source = 'refresh') {
  busySource.set(source)
  loading.set(true)
  errorText.set('')
  try {
    const response = await fetch(publicationsUrl({ page: page(), perPage: PUBLICATIONS_PER_PAGE, status: status() }), {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    })

    if (!response.ok) {
      errorText.set(listErrorMessage(response.status))
      publications.set([])
      return
    }

    const body = await response.json()
    publications.set(toPublicationViews(body))
    hasMore.set(body?.has_more_pages === true)
  }
  catch {
    // A network failure, not a refusal: there is no status to explain.
    errorText.set('Publications could not be loaded. Check your connection and try again.')
    publications.set([])
  }
  finally {
    loading.set(false)
  }
}

function onStatusChange() {
  page.set(1)
  void load()
}

function nextPage() {
  if (!hasMore() || loading())
    return
  page.update(value => value + 1)
  void load('next')
}

function previousPage() {
  if (page() <= 1 || loading())
    return
  page.update(value => value - 1)
  void load('prev')
}

function writeHeaders() {
  return {
    'Content-Type': 'application/json',
    'Accept': 'application/json',
    'X-CSRF-Token': csrfToken() || '',
  }
}

async function setStatus(id, next) {
  if (busyId() || !next)
    return
  busyId.set(id)
  actionError.set('')
  try {
    const response = await fetch(publicationUrl(id), {
      method: 'PATCH',
      credentials: 'same-origin',
      headers: writeHeaders(),
      body: JSON.stringify({ status: next }),
    })

    if (!response.ok)
      actionError.set(saveErrorMessage(response.status))
    /* Read again either way: on a 404 the list on screen is the stale thing. */
    await load()
  }
  catch {
    actionError.set('That change could not be saved. Check your connection and try again.')
  }
  finally {
    busyId.set(0)
  }
}

function toggleAdd() {
  addOpen.update(value => !value)
  addError.set('')
}

async function addPublication() {
  const draft = { name: addName(), slug: addSlug(), access: addAccess(), description: addDescription() }
  const problem = draftError(draft)
  if (problem) {
    addError.set(problem)
    return
  }

  saving.set(true)
  addError.set('')
  try {
    const response = await fetch(PUBLICATIONS_ENDPOINT, {
      method: 'POST',
      credentials: 'same-origin',
      headers: writeHeaders(),
      body: JSON.stringify(publicationPayload(draft)),
    })

    if (response.status === 201 || response.ok) {
      addName.set('')
      addSlug.set('')
      addAccess.set('free')
      addDescription.set('')
      addOpen.set(false)
      status.set('')
      page.set(1)
      await load()
      return
    }

    addError.set(saveErrorMessage(response.status))
  }
  catch {
    addError.set('The publication could not be saved. Check your connection and try again.')
  }
  finally {
    saving.set(false)
  }
}

onMount(() => {
  void load()
})
</script>

<main id="main" class="p-5 sm:p-8 min-h-screen text-fg bg-page">
  <div class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-7">
      <div>
        <p class="font-bold text-[11px] text-accent tracking-[0.2em] uppercase">Publishing</p>
        <h1 class="mt-2 font-semibold text-4xl tracking-[-0.04em]">Give every publication a home of its own.</h1>
        <p class="mt-2 max-w-2xl text-fg-muted text-sm">The publications this workspace runs. Each one is a home that members, podcasts and referrals attach to.</p>
      </div>
      <div class="flex gap-2">
        <button type="button" @click="load()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Refresh</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">New publication</button>
      </div>
    </header>

    <p class="flex gap-3 items-start mb-5 p-4 text-sm bg-panel border border-line rounded-panel">
      <span aria-hidden="true" class="shrink-0 mt-0.5 h-5 w-5 text-fg-muted i-hugeicons-information-circle"></span>
      <span>Posts cannot be written or published here yet. A publication's status is a label on its record and does not put anything on the web.</span>
    </p>

    <section :if="addOpen()" class="mb-5 p-5 bg-panel border border-line rounded-panel" aria-labelledby="add-publication-title">
      <h2 id="add-publication-title" class="font-bold text-sm">Start a publication</h2>
      <p class="mt-1 text-fg-muted text-xs">It is saved as a draft.</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mt-4">
        <label class="block font-bold text-xs">
          Name
          <input x-model.trim="addName" type="text" autocomplete="off" maxlength="160" class="mt-1 field" placeholder="Sunday Paper">
        </label>
        <label class="block font-bold text-xs">
          Short name
          <input x-model.trim="addSlug" type="text" autocomplete="off" autocapitalize="off" maxlength="120" class="mt-1 field" placeholder="Left blank, it follows the name">
        </label>
        <label class="block font-bold text-xs">
          Access
          <select x-model="addAccess" class="mt-1 field">
            @foreach(accessOptions as option)
              <option value="{{ option.value }}">{{ option.label }}</option>
            @endforeach
          </select>
        </label>
        <label class="block font-bold text-xs">
          Description, if any
          <input x-model.trim="addDescription" type="text" autocomplete="off" maxlength="1000" class="mt-1 field" placeholder="What readers get">
        </label>
      </div>
      <p :if="addError()" class="mt-3 font-bold text-danger text-xs" role="alert">{{ addError() }}</p>
      <div class="flex gap-2 mt-4">
        <button type="button" @click="addPublication()" :disabled="saving()" :aria-busy="saving()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Save draft</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Cancel</button>
      </div>
    </section>

    <p :if="actionError()" class="mb-5 p-4 font-bold text-danger text-sm bg-panel border border-line rounded-panel" role="alert">{{ actionError() }}</p>

    <section class="overflow-hidden bg-panel border border-line rounded-panel" aria-labelledby="publications-title">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-5 border-b border-line">
        <h2 id="publications-title" class="font-bold">Publications</h2>
        <label class="block">
          <span class="sr-only">Filter by status</span>
          <select x-model="status" @change="onStatusChange()" class="field">
            <option value="">Every status</option>
            @foreach(statusOptions as option)
              <option value="{{ option.value }}">{{ option.label }}</option>
            @endforeach
          </select>
        </label>
      </div>

      {{-- Loading. A row-shaped skeleton rather than a spinner, so the list
           does not jump height when the rows land. --}}
      <div :if="loading()" class="p-5 space-y-3" aria-hidden="true">
        <div class="h-16 bg-surface-sunken rounded-control"></div>
        <div class="h-16 bg-surface-sunken rounded-control"></div>
      </div>
      <p :if="loading()" class="sr-only" role="status">Loading publications</p>

      <div :if="errorText()" class="p-8 text-center" role="alert">
        <span aria-hidden="true" class="inline-block h-6 w-6 text-danger i-hugeicons-alert-02"></span>
        <p class="mt-3 font-bold text-sm">{{ errorText() }}</p>
        <button type="button" @click="load()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="mt-4 px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-60">Try again</button>
      </div>

      <div :if="showEmpty()" class="p-10 text-center">
        <span aria-hidden="true" class="inline-block h-7 w-7 text-fg-muted i-hugeicons-news-01"></span>
        <p class="mt-3 font-bold">No publications match this view.</p>
        <p class="mt-1 text-fg-muted text-sm">Clear the status filter to see every publication, or start the first one.</p>
      </div>

      <div :if="showList()" class="divide-line divide-y">
        <template :for="publication in publications()">
          <article class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-5">
            <div class="min-w-0">
              <h3 class="font-bold text-sm">{{ publication.name }}</h3>
              <p class="mt-0.5 text-fg-muted text-xs">{{ publication.statusLabel }}, {{ publication.accessLabel }}. Short name <code>{{ publication.slug }}</code>. Last changed {{ publication.updatedLabel }}.</p>
              <p :if="publication.description" class="mt-0.5 text-xs">{{ publication.description }}</p>
            </div>
            <div class="flex flex-wrap gap-2 shrink-0">
              <button :if="publication.nextStatus" type="button" @click="setStatus(publication.id, publication.nextStatus)" :disabled="busyId() !== 0" :aria-busy="busyId() === publication.id" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">{{ publication.nextLabel }}</button>
              <button :if="publication.canArchive" type="button" @click="setStatus(publication.id, 'archived')" :disabled="busyId() !== 0" :aria-busy="busyId() === publication.id" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Archive</button>
            </div>
          </article>
        </template>
      </div>

      <div :if="showList()" class="flex items-center justify-between p-4 border-line border-t">
        <p class="m-0 text-fg-muted text-xs">Page {{ page() }}</p>
        <div class="flex gap-2">
          <button type="button" @click="previousPage()" :disabled="page() <= 1 || prevBusy()" :aria-busy="prevBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Previous</button>
          <button type="button" @click="nextPage()" :disabled="!hasMore() || nextBusy()" :aria-busy="nextBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Next</button>
        </div>
      </div>
    </section>
  </div>
</main>
