<script client>
/**
 * Workspace settings, through the application's own API.
 *
 * This page was the `settings` area of `WorkspaceSurface`: a configuration
 * health score, a policy version, retention rules, a timezone and consent
 * defaults, with a Save button that saved nothing. None of those is stored
 * for a workspace.
 *
 * It reads and writes the two things that are: the workspace's name and a
 * short description. The name is what the command center greets people with
 * and what an invitation says they are joining. Owners and admins can change
 * them; everyone else sees them read-only, and the server enforces that
 * whatever this page shows.
 *
 * `settings-query.ts` records the controls the old page had that this one
 * does not, and why.
 *
 * Writes carry the CSRF token explicitly, read with `useCookie`, the
 * composable, since a client script may not reach for the DOM itself.
 */
import {
  isChanged,
  SETTINGS_ENDPOINT,
  settingsDraftError,
  settingsLoadError,
  settingsPayload,
  settingsSaveError,
  toSettingsView,
} from '../../data/settings-query'

const saved = state(toSettingsView(null))
const name = state('')
const description = state('')
const loading = state(true)
const errorText = state('')
const saving = state(false)
const saveError = state('')
const saveNotice = state('')

const csrfToken = useCookie('X-CSRF-Token')

const showForm = derived(() => !loading() && !errorText())
const canEdit = derived(() => saved().canEdit)
const readOnly = derived(() => !saved().canEdit)
const dirty = derived(() => isChanged({ name: name(), description: description() }, saved()))

function apply(body) {
  const view = toSettingsView(body)
  /* A save answers without the created date; keep the one already read. */
  saved.set({ ...view, createdLabel: view.createdLabel || saved().createdLabel })
  name.set(view.name)
  description.set(view.description)
}

async function load() {
  loading.set(true)
  errorText.set('')
  saveError.set('')
  saveNotice.set('')
  try {
    const response = await fetch(SETTINGS_ENDPOINT, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
    if (!response.ok) {
      errorText.set(settingsLoadError(response.status))
      return
    }
    apply(await response.json())
  }
  catch {
    // A network failure, not a refusal: there is no status to explain.
    errorText.set('Settings could not be loaded. Check your connection and try again.')
  }
  finally {
    loading.set(false)
  }
}

async function save() {
  if (saving() || !canEdit())
    return
  const draft = { name: name(), description: description() }
  const problem = settingsDraftError(draft)
  saveNotice.set('')
  if (problem) {
    saveError.set(problem)
    return
  }
  if (!dirty()) {
    saveError.set('')
    saveNotice.set('Nothing has changed.')
    return
  }

  saving.set(true)
  saveError.set('')
  try {
    const response = await fetch(SETTINGS_ENDPOINT, {
      method: 'PATCH',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrfToken() || '' },
      body: JSON.stringify(settingsPayload(draft)),
    })
    if (!response.ok) {
      saveError.set(settingsSaveError(response.status))
      return
    }
    apply(await response.json())
    saveNotice.set('Saved. The new name shows across the workspace from the next page load.')
  }
  catch {
    saveError.set('The settings could not be saved. Check your connection and try again.')
  }
  finally {
    saving.set(false)
  }
}

function reset() {
  name.set(saved().name)
  description.set(saved().description)
  saveError.set('')
  saveNotice.set('')
}

onMount(() => {
  void load()
})
</script>

<main id="main" class="p-5 sm:p-8 min-h-screen text-fg bg-page">
  <div class="mx-auto max-w-[900px]">
    <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-7">
      <div>
        <p class="font-bold text-[11px] text-accent tracking-[0.2em] uppercase">Workspace settings</p>
        <h1 class="mt-2 font-semibold text-4xl tracking-[-0.04em]">Name the place the work happens.</h1>
        <p class="mt-2 max-w-2xl text-fg-muted text-sm">What this workspace is called and what it is for. The name greets everyone on the command center and appears on every invitation.</p>
      </div>
      <div class="flex gap-2">
        <button type="button" @click="load()" :disabled="loading()" :aria-busy="loading()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Refresh</button>
      </div>
    </header>

    {{-- Loading. A form-shaped skeleton rather than a spinner, so the page
         does not jump height when the fields land. --}}
    <div :if="loading()" class="p-5 space-y-3 bg-panel border border-line rounded-panel" aria-hidden="true">
      <div class="h-11 bg-surface-sunken rounded-control"></div>
      <div class="h-24 bg-surface-sunken rounded-control"></div>
    </div>
    <p :if="loading()" class="sr-only" role="status">Loading settings</p>

    <div :if="errorText()" class="p-8 text-center bg-panel border border-line rounded-panel" role="alert">
      <span aria-hidden="true" class="inline-block h-6 w-6 text-danger i-hugeicons-alert-02"></span>
      <p class="mt-3 font-bold text-sm">{{ errorText() }}</p>
      <button type="button" @click="load()" :disabled="loading()" :aria-busy="loading()" class="mt-4 px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Try again</button>
    </div>

    <section :if="showForm()" class="p-5 bg-panel border border-line rounded-panel" aria-labelledby="identity-title">
      <h2 id="identity-title" class="font-bold">Workspace identity</h2>
      <p :if="readOnly()" class="mt-1 text-fg-muted text-xs">Only an owner or admin can change these. You can see them, not edit them.</p>
      <label class="block mt-4 font-bold text-xs">
        Name
        <input x-model="name" type="text" autocomplete="off" maxlength="80" :disabled="readOnly()" class="mt-1 disabled:opacity-70 field" placeholder="Sunday Paper Co.">
      </label>
      <label class="block mt-3 font-bold text-xs">
        Description, if any
        <textarea x-model="description" rows="3" maxlength="280" :disabled="readOnly()" class="mt-1 disabled:opacity-70 field" placeholder="What this workspace is for"></textarea>
      </label>
      <p :if="saved().createdLabel" class="mt-3 text-fg-muted text-xs">{{ saved().createdLabel }}</p>
      <p :if="saveError()" class="mt-3 font-bold text-danger text-xs" role="alert">{{ saveError() }}</p>
      <p :if="saveNotice()" class="mt-3 font-bold text-xs" role="status">{{ saveNotice() }}</p>
      <div :if="canEdit()" class="flex gap-2 mt-4">
        <button type="button" @click="save()" :disabled="saving()" :aria-busy="saving()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Save settings</button>
        <button type="button" @click="reset()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Undo changes</button>
      </div>
    </section>

    <p :if="showForm()" class="flex gap-3 items-start mt-5 p-4 text-sm bg-panel border border-line rounded-panel">
      <span aria-hidden="true" class="shrink-0 mt-0.5 h-5 w-5 text-fg-muted i-hugeicons-information-circle"></span>
      <span>Consent rules, quiet hours and the timezone are the same for every workspace and are not set here. People and roles are on the Team page, and sending domains on the Domains page.</span>
    </p>
  </div>
</main>
