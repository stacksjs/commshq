<script server>
/* The fixed list from the module, rendered here rather than looped in the
 * browser, so the select is usable in the first paint. */
import { SPONSOR_STATUSES } from '../../data/monetization-query'

export const statusOptions = SPONSOR_STATUSES
</script>

<script client>
/**
 * Sponsors and earnings, through the application's own API.
 *
 * This page was the `monetization` area of `WorkspaceSurface`: $31,842 of
 * net earnings, a 72% sponsor fill rate, referral income and a scheduled
 * payout, none of it read from anywhere.
 *
 * It lists sponsors from `GET /api/v1/sponsors`, adds one as a prospect and
 * moves it between statuses, and it shows the latest entries of the earnings
 * ledger from `GET /api/v1/earnings`. Nothing records an earning yet, so the
 * ledger is normally empty and the page says why. A sponsor's status is a
 * label on the record. `monetization-query.ts` records what else the old
 * page showed that has nothing behind it.
 *
 * A sponsor's website is only rendered as a link when it is a plain http or
 * https address; the module decides, never the markup.
 *
 * Writes carry the CSRF token explicitly, read with `useCookie`, the
 * composable, since a client script may not reach for the DOM itself.
 */
import {
  draftError,
  earningsUrl,
  listErrorMessage,
  saveErrorMessage,
  sponsorPayload,
  SPONSORS_ENDPOINT,
  SPONSORS_PER_PAGE,
  sponsorsUrl,
  sponsorUrl,
  toEarningViews,
  toSponsorViews,
} from '../../data/monetization-query'

const sponsors = state([])
const earnings = state([])
const earningsError = state('')
const earningsLoaded = state(false)
const hasMore = state(false)
const page = state(1)
const status = state('')
const loading = state(true)
const errorText = state('')
const actionError = state('')
/* Which control the in-flight load belongs to, so one busy state is announced
 * rather than three. */
const busySource = state('refresh')
/* The sponsor a status change is in flight for, so only its buttons are busy. */
const busyId = state(0)

const addOpen = state(false)
const addName = state('')
const addEmail = state('')
const addWebsite = state('')
const addNotes = state('')
const saving = state(false)
const addError = state('')

const csrfToken = useCookie('X-CSRF-Token')

const refreshBusy = derived(() => loading() && busySource() === 'refresh')
const prevBusy = derived(() => loading() && busySource() === 'prev')
const nextBusy = derived(() => loading() && busySource() === 'next')
const showEmpty = derived(() => !loading() && !errorText() && sponsors().length === 0)
const showList = derived(() => !loading() && !errorText() && sponsors().length > 0)
const showNoEarnings = derived(() => earningsLoaded() && !earningsError() && earnings().length === 0)
const showEarnings = derived(() => earningsLoaded() && !earningsError() && earnings().length > 0)

/* The ledger is its own request and its own failure: sponsors still list
 * when it cannot be read, and the panel says so in its own place. */
async function loadEarnings() {
  earningsError.set('')
  try {
    const response = await fetch(earningsUrl(), { credentials: 'same-origin', headers: { Accept: 'application/json' } })
    if (!response.ok) {
      earningsError.set(listErrorMessage(response.status, 'earnings'))
      earnings.set([])
      return
    }
    earnings.set(toEarningViews(await response.json()))
  }
  catch {
    earningsError.set('Earnings could not be loaded. Check your connection and try again.')
    earnings.set([])
  }
  finally {
    earningsLoaded.set(true)
  }
}

async function load(source = 'refresh') {
  busySource.set(source)
  loading.set(true)
  errorText.set('')
  try {
    const response = await fetch(sponsorsUrl({ page: page(), perPage: SPONSORS_PER_PAGE, status: status() }), {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    })

    if (!response.ok) {
      errorText.set(listErrorMessage(response.status, 'sponsors'))
      sponsors.set([])
      return
    }

    const body = await response.json()
    sponsors.set(toSponsorViews(body))
    hasMore.set(body?.has_more_pages === true)
  }
  catch {
    // A network failure, not a refusal: there is no status to explain.
    errorText.set('Sponsors could not be loaded. Check your connection and try again.')
    sponsors.set([])
  }
  finally {
    loading.set(false)
  }
}

function refresh() {
  void load()
  void loadEarnings()
}

function onStatusChange() {
  page.set(1)
  void load()
}

function nextPage() {
  if (!hasMore() || loading())
    return
  page.update(value => value + 1)
  void load('next')
}

function previousPage() {
  if (page() <= 1 || loading())
    return
  page.update(value => value - 1)
  void load('prev')
}

function writeHeaders() {
  return {
    'Content-Type': 'application/json',
    'Accept': 'application/json',
    'X-CSRF-Token': csrfToken() || '',
  }
}

async function setStatus(id, next) {
  if (busyId() || !next)
    return
  busyId.set(id)
  actionError.set('')
  try {
    const response = await fetch(sponsorUrl(id), {
      method: 'PATCH',
      credentials: 'same-origin',
      headers: writeHeaders(),
      body: JSON.stringify({ status: next }),
    })

    if (!response.ok)
      actionError.set(saveErrorMessage(response.status))
    /* Read again either way: on a 404 the list on screen is the stale thing. */
    await load()
  }
  catch {
    actionError.set('That change could not be saved. Check your connection and try again.')
  }
  finally {
    busyId.set(0)
  }
}

function toggleAdd() {
  addOpen.update(value => !value)
  addError.set('')
}

async function addSponsor() {
  const draft = { name: addName(), email: addEmail(), website: addWebsite(), notes: addNotes() }
  const problem = draftError(draft)
  if (problem) {
    addError.set(problem)
    return
  }

  saving.set(true)
  addError.set('')
  try {
    const response = await fetch(SPONSORS_ENDPOINT, {
      method: 'POST',
      credentials: 'same-origin',
      headers: writeHeaders(),
      body: JSON.stringify(sponsorPayload(draft)),
    })

    if (response.status === 201 || response.ok) {
      addName.set('')
      addEmail.set('')
      addWebsite.set('')
      addNotes.set('')
      addOpen.set(false)
      status.set('')
      page.set(1)
      await load()
      return
    }

    addError.set(saveErrorMessage(response.status))
  }
  catch {
    addError.set('The sponsor could not be saved. Check your connection and try again.')
  }
  finally {
    saving.set(false)
  }
}

onMount(() => {
  refresh()
})
</script>

<main id="main" class="p-5 sm:p-8 min-h-screen text-fg bg-page">
  <div class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-7">
      <div>
        <p class="font-bold text-[11px] text-accent tracking-[0.2em] uppercase">Monetization</p>
        <h1 class="mt-2 font-semibold text-4xl tracking-[-0.04em]">Earn without losing the reader's trust.</h1>
        <p class="mt-2 max-w-2xl text-fg-muted text-sm">The sponsors this workspace works with, and the earnings recorded for it.</p>
      </div>
      <div class="flex gap-2">
        <button type="button" @click="refresh()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Refresh</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Add sponsor</button>
      </div>
    </header>

    <section :if="addOpen()" class="mb-5 p-5 bg-panel border border-line rounded-panel" aria-labelledby="add-sponsor-title">
      <h2 id="add-sponsor-title" class="font-bold text-sm">Add a sponsor</h2>
      <p class="mt-1 text-fg-muted text-xs">It is saved as a prospect. This is a record of who you work with; placements and payouts are not handled here yet.</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mt-4">
        <label class="block font-bold text-xs">
          Name
          <input x-model.trim="addName" type="text" autocomplete="off" maxlength="180" class="mt-1 field" placeholder="Studio Supply Co.">
        </label>
        <label class="block font-bold text-xs">
          Contact email
          <input x-model.trim="addEmail" type="email" autocomplete="off" maxlength="255" class="mt-1 field" placeholder="ads@example.com">
        </label>
        <label class="block font-bold text-xs">
          Website, if any
          <input x-model.trim="addWebsite" type="url" autocomplete="off" autocapitalize="off" maxlength="2048" class="mt-1 field" placeholder="https://example.com">
        </label>
        <label class="block font-bold text-xs">
          Notes, if any
          <input x-model.trim="addNotes" type="text" autocomplete="off" maxlength="4000" class="mt-1 field" placeholder="Anything worth remembering">
        </label>
      </div>
      <p :if="addError()" class="mt-3 font-bold text-danger text-xs" role="alert">{{ addError() }}</p>
      <div class="flex gap-2 mt-4">
        <button type="button" @click="addSponsor()" :disabled="saving()" :aria-busy="saving()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Save sponsor</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Cancel</button>
      </div>
    </section>

    <p :if="actionError()" class="mb-5 p-4 font-bold text-danger text-sm bg-panel border border-line rounded-panel" role="alert">{{ actionError() }}</p>

    <section class="overflow-hidden bg-panel border border-line rounded-panel" aria-labelledby="sponsors-title">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-5 border-b border-line">
        <h2 id="sponsors-title" class="font-bold">Sponsors</h2>
        <label class="block">
          <span class="sr-only">Filter by status</span>
          <select x-model="status" @change="onStatusChange()" class="field">
            <option value="">Every status</option>
            @foreach(statusOptions as option)
              <option value="{{ option.value }}">{{ option.label }}</option>
            @endforeach
          </select>
        </label>
      </div>

      {{-- Loading. A row-shaped skeleton rather than a spinner, so the list
           does not jump height when the rows land. --}}
      <div :if="loading()" class="p-5 space-y-3" aria-hidden="true">
        <div class="h-16 bg-surface-sunken rounded-control"></div>
        <div class="h-16 bg-surface-sunken rounded-control"></div>
      </div>
      <p :if="loading()" class="sr-only" role="status">Loading sponsors</p>

      <div :if="errorText()" class="p-8 text-center" role="alert">
        <span aria-hidden="true" class="inline-block h-6 w-6 text-danger i-hugeicons-alert-02"></span>
        <p class="mt-3 font-bold text-sm">{{ errorText() }}</p>
        <button type="button" @click="load()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="mt-4 px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Try again</button>
      </div>

      <div :if="showEmpty()" class="p-10 text-center">
        <span aria-hidden="true" class="inline-block h-7 w-7 text-fg-muted i-hugeicons-megaphone-02"></span>
        <p class="mt-3 font-bold">No sponsors match this view.</p>
        <p class="mt-1 text-fg-muted text-sm">Clear the status filter to see every sponsor, or add the first one.</p>
      </div>

      <div :if="showList()" class="divide-line divide-y">
        <template :for="sponsor in sponsors()">
          <article class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-5">
            <div class="min-w-0">
              <h3 class="font-bold text-sm">{{ sponsor.name }}</h3>
              <p class="mt-0.5 break-all text-fg-muted text-xs">{{ sponsor.statusLabel }}. {{ sponsor.email }}. Last changed {{ sponsor.updatedLabel }}.</p>
              <p :if="sponsor.website" class="mt-0.5 text-xs"><a :href="sponsor.website" target="_blank" rel="noopener noreferrer nofollow" class="font-bold text-fg">{{ sponsor.websiteLabel }}</a></p>
              <p :if="sponsor.notes" class="mt-0.5 text-xs">{{ sponsor.notes }}</p>
            </div>
            <div class="flex flex-wrap gap-2 shrink-0">
              <button :if="sponsor.nextStatus" type="button" @click="setStatus(sponsor.id, sponsor.nextStatus)" :disabled="busyId() !== 0" :aria-busy="busyId() === sponsor.id" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">{{ sponsor.nextLabel }}</button>
              <button :if="sponsor.canBlock" type="button" @click="setStatus(sponsor.id, 'blocked')" :disabled="busyId() !== 0" :aria-busy="busyId() === sponsor.id" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Block</button>
            </div>
          </article>
        </template>
      </div>

      <div :if="showList()" class="flex items-center justify-between p-4 border-line border-t">
        <p class="m-0 text-fg-muted text-xs">Page {{ page() }}</p>
        <div class="flex gap-2">
          <button type="button" @click="previousPage()" :disabled="page() <= 1 || prevBusy()" :aria-busy="prevBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Previous</button>
          <button type="button" @click="nextPage()" :disabled="!hasMore() || nextBusy()" :aria-busy="nextBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Next</button>
        </div>
      </div>
    </section>

    <section class="overflow-hidden mt-5 bg-panel border border-line rounded-panel" aria-labelledby="earnings-title">
      <div class="p-5 border-b border-line">
        <h2 id="earnings-title" class="font-bold">Recent earnings</h2>
      </div>
      <p :if="earningsError()" class="p-5 font-bold text-danger text-sm" role="alert">{{ earningsError() }}</p>
      <div :if="showNoEarnings()" class="p-8 text-center">
        <span aria-hidden="true" class="inline-block h-7 w-7 text-fg-muted i-hugeicons-coins-dollar"></span>
        <p class="mt-3 font-bold">No earnings have been recorded.</p>
        <p class="mt-1 text-fg-muted text-sm">Nothing records sponsor, referral or subscription income yet, so this stays empty for now.</p>
      </div>
      <div :if="showEarnings()" class="divide-line divide-y">
        <template :for="earning in earnings()">
          <article class="flex gap-3 items-center justify-between p-5">
            <div class="min-w-0">
              <h3 class="font-bold text-sm">{{ earning.sourceLabel }}</h3>
              <p class="mt-0.5 text-fg-muted text-xs">{{ earning.whenLabel }}. {{ earning.detail }}.</p>
            </div>
            <p class="shrink-0 m-0 font-bold text-sm">{{ earning.netLabel }}</p>
          </article>
        </template>
      </div>
    </section>
  </div>
</main>
