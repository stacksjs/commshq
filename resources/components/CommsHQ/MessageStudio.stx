<script server>
/* The channel options are a fixed list from the model's own enum, so they are
 * rendered here rather than looped in the browser: both selects are usable in
 * the first paint and there is nothing for hydration to rebuild. */
import { TEMPLATE_CHANNELS } from '../../data/templates-query'

export const channelOptions = TEMPLATE_CHANNELS
</script>

<script client>
/**
 * The message studio, reading the application's own API.
 *
 * This page was the `editor` area of `WorkspaceSurface`, which stated 34
 * reusable blocks, 12 templates across 4 channels and 186 draft revisions,
 * plus three named drafts at versions this workspace never reached. All of it
 * was literal. Everything below comes from `GET /api/v1/message-templates`,
 * which `MessageTemplate`'s `useApi` trait already published behind the `auth`
 * and `team` middleware, scoped to the caller's team.
 *
 * It lists and creates templates. It does not edit their blocks: there is no
 * block editor in this application yet, so a new template is saved with the
 * empty document the model requires and the list says "No blocks yet" rather
 * than implying a canvas that does not exist. No search box either, because
 * the model declares no searchable fields; the channel filter is real.
 *
 * Writes carry the CSRF token explicitly, read with `useCookie`, the
 * composable, since a client script may not reach for the DOM itself.
 */
import {
  draftError,
  listErrorMessage,
  saveErrorMessage,
  templatePayload,
  TEMPLATES_ENDPOINT,
  TEMPLATES_PER_PAGE,
  templatesUrl,
  toTemplateViews,
} from '../../data/templates-query'

const templates = state([])
const total = state(null)
const hasMore = state(false)
const page = state(1)
const channel = state('')
const loading = state(true)
const errorText = state('')
/* Which control the in-flight load belongs to, so one busy state is announced
 * rather than three. */
const busySource = state('refresh')

const addOpen = state(false)
const addName = state('')
const addChannel = state('email')
const addSubject = state('')
const saving = state(false)
const addError = state('')

const csrfToken = useCookie('X-CSRF-Token')

const refreshBusy = derived(() => loading() && busySource() === 'refresh')
const prevBusy = derived(() => loading() && busySource() === 'prev')
const nextBusy = derived(() => loading() && busySource() === 'next')
const showEmpty = derived(() => !loading() && !errorText() && templates().length === 0)
const showTable = derived(() => !loading() && !errorText() && templates().length > 0)
const countLabel = derived(() => {
  const shown = templates().length
  const all = total()
  if (typeof all === 'number')
    return `${shown} of ${all}`
  return String(shown)
})

async function load(source = 'refresh') {
  busySource.set(source)
  loading.set(true)
  errorText.set('')
  try {
    const response = await fetch(templatesUrl({ page: page(), perPage: TEMPLATES_PER_PAGE, channel: channel() }), {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    })

    if (!response.ok) {
      errorText.set(listErrorMessage(response.status))
      templates.set([])
      return
    }

    const body = await response.json()
    templates.set(toTemplateViews(body))
    total.set(typeof body?.total === 'number' ? body.total : null)
    hasMore.set(body?.has_more_pages === true)
  }
  catch {
    // A network failure, not a refusal: there is no status to explain.
    errorText.set('Templates could not be loaded. Check your connection and try again.')
    templates.set([])
  }
  finally {
    loading.set(false)
  }
}

function onChannelChange() {
  page.set(1)
  void load()
}

function nextPage() {
  if (!hasMore() || loading())
    return
  page.update(value => value + 1)
  void load('next')
}

function previousPage() {
  if (page() <= 1 || loading())
    return
  page.update(value => value - 1)
  void load('prev')
}

function toggleAdd() {
  addOpen.update(value => !value)
  addError.set('')
}

async function addTemplate() {
  const draft = { name: addName(), channel: addChannel(), subject: addSubject() }
  const problem = draftError(draft)
  if (problem) {
    addError.set(problem)
    return
  }

  saving.set(true)
  addError.set('')
  try {
    const response = await fetch(TEMPLATES_ENDPOINT, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken() || '',
      },
      body: JSON.stringify(templatePayload(draft)),
    })

    if (response.status === 201 || response.ok) {
      addName.set('')
      addChannel.set('email')
      addSubject.set('')
      addOpen.set(false)
      page.set(1)
      await load()
      return
    }

    addError.set(saveErrorMessage(response.status))
  }
  catch {
    addError.set('The template could not be saved. Check your connection and try again.')
  }
  finally {
    saving.set(false)
  }
}

onMount(() => {
  void load()
})
</script>

<main id="main" class="p-5 sm:p-8 min-h-screen text-fg bg-page">
  <div class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-7">
      <div>
        <p class="font-bold text-[11px] text-accent tracking-[0.2em] uppercase">Message studio</p>
        <h1 class="mt-2 font-semibold text-4xl tracking-[-0.04em]">Shape one story for every screen.</h1>
        <p class="mt-2 max-w-2xl text-fg-muted text-sm">The templates this workspace sends from, by channel. Each row reports its own revision and how many blocks it holds.</p>
      </div>
      <div class="flex gap-2">
        <button type="button" @click="load()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Refresh</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">New template</button>
      </div>
    </header>

    <section :if="addOpen()" class="mb-5 p-5 bg-panel border border-line rounded-panel" aria-labelledby="add-template-title">
      <h2 id="add-template-title" class="font-bold text-sm">Create a template</h2>
      <p class="mt-1 text-fg-muted text-xs">It is saved at revision one with no blocks. A subject line is kept for email only, the one channel that has one.</p>
      <div class="grid gap-3 sm:grid-cols-3 mt-4">
        <label class="block font-bold text-xs">
          Name
          <input x-model.trim="addName" type="text" autocomplete="off" maxlength="120" class="mt-1 field" placeholder="Welcome series">
        </label>
        <label class="block font-bold text-xs">
          Channel
          <select x-model="addChannel" class="mt-1 field">
            @foreach(channelOptions as option)
              <option value="{{ option.value }}">{{ option.label }}</option>
            @endforeach
          </select>
        </label>
        <label class="block font-bold text-xs">
          Subject line
          <input x-model.trim="addSubject" type="text" autocomplete="off" maxlength="255" class="mt-1 field">
        </label>
      </div>
      <p :if="addError()" class="mt-3 font-bold text-danger text-xs" role="alert">{{ addError() }}</p>
      <div class="flex gap-2 mt-4">
        <button type="button" @click="addTemplate()" :disabled="saving()" :aria-busy="saving()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Save template</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Cancel</button>
      </div>
    </section>

    <section class="overflow-hidden bg-panel border border-line rounded-panel" aria-labelledby="templates-title">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-5 border-b border-line">
        <div>
          <h2 id="templates-title" class="font-bold">Templates</h2>
          <p class="text-fg-muted text-xs">Showing {{ countLabel() }}</p>
        </div>
        <label class="block">
          <span class="sr-only">Filter by channel</span>
          <select x-model="channel" @change="onChannelChange()" class="field">
            <option value="">Every channel</option>
            @foreach(channelOptions as option)
              <option value="{{ option.value }}">{{ option.label }}</option>
            @endforeach
          </select>
        </label>
      </div>

      {{-- Loading. A row-shaped skeleton rather than a spinner, so the table
           does not jump height when the rows land. --}}
      <div :if="loading()" class="p-5 space-y-3" aria-hidden="true">
        <div class="h-10 bg-surface-sunken rounded-control"></div>
        <div class="h-10 bg-surface-sunken rounded-control"></div>
        <div class="h-10 bg-surface-sunken rounded-control"></div>
      </div>
      <p :if="loading()" class="sr-only" role="status">Loading templates</p>

      <div :if="errorText()" class="p-8 text-center" role="alert">
        <span aria-hidden="true" class="inline-block h-6 w-6 text-danger i-hugeicons-alert-02"></span>
        <p class="mt-3 font-bold text-sm">{{ errorText() }}</p>
        <button type="button" @click="load()" :disabled="refreshBusy()" :aria-busy="refreshBusy()" class="mt-4 px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-60">Try again</button>
      </div>

      <div :if="showEmpty()" class="p-10 text-center">
        <span aria-hidden="true" class="inline-block h-7 w-7 text-fg-muted i-hugeicons-edit-02"></span>
        <p class="mt-3 font-bold">No templates match this view.</p>
        <p class="mt-1 text-fg-muted text-sm">Clear the channel filter to see every template, or create the first one for this channel.</p>
      </div>

      {{-- Phone: one card per template. The table below carries five columns,
           which cannot be read at 390px without horizontal scrolling. --}}
      <div :if="showTable()" class="sm:hidden divide-line divide-y">
        <template :for="template in templates()">
          <article class="p-5">
            <h3 class="font-bold text-sm">{{ template.name }}</h3>
            <p class="mt-0.5 text-fg-muted text-xs">{{ template.subject }}</p>
            <dl class="grid gap-3 grid-cols-2 mt-4 text-xs">
              <div>
                <dt class="text-fg-muted">Channel</dt>
                <dd class="mt-1 font-medium">{{ template.channelLabel }}</dd>
              </div>
              <div>
                <dt class="text-fg-muted">Content</dt>
                <dd class="mt-1 font-medium">{{ template.contentLabel }}</dd>
              </div>
              <div>
                <dt class="text-fg-muted">Revision</dt>
                <dd class="mt-1 font-medium">{{ template.revisionLabel }}</dd>
              </div>
              <div>
                <dt class="text-fg-muted">Last changed</dt>
                <dd class="mt-1 font-medium">{{ template.updatedLabel }}</dd>
              </div>
            </dl>
          </article>
        </template>
      </div>

      <div :if="showTable()" class="hidden sm:block overflow-x-auto">
        <table class="min-w-[760px] w-full text-left">
          <caption class="sr-only">Message templates in this workspace</caption>
          <thead class="text-[10px] text-fg-muted tracking-[0.14em] uppercase bg-surface-sunken">
            <tr>
              <th scope="col" class="px-5 py-3">Template</th>
              <th scope="col" class="px-5 py-3">Channel</th>
              <th scope="col" class="px-5 py-3">Content</th>
              <th scope="col" class="px-5 py-3">Revision</th>
              <th scope="col" class="px-5 py-3">Last changed</th>
            </tr>
          </thead>
          <tbody>
            <template :for="template in templates()">
              <tr class="hover:bg-surface-hover border-line border-t">
                <td class="px-5 py-4">
                  <p class="font-bold text-sm">{{ template.name }}</p>
                  <p class="mt-0.5 text-fg-muted text-xs">{{ template.subject }}</p>
                </td>
                <td class="px-5 py-4 text-sm">{{ template.channelLabel }}</td>
                <td class="px-5 py-4 text-sm">{{ template.contentLabel }}</td>
                <td class="px-5 py-4 text-sm">{{ template.revisionLabel }}</td>
                <td class="px-5 py-4 text-sm">{{ template.updatedLabel }}</td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <div :if="showTable()" class="flex items-center justify-between p-4 border-line border-t">
        <p class="m-0 text-fg-muted text-xs">Page {{ page() }}</p>
        <div class="flex gap-2">
          <button type="button" @click="previousPage()" :disabled="page() <= 1 || prevBusy()" :aria-busy="prevBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Previous</button>
          <button type="button" @click="nextPage()" :disabled="!hasMore() || nextBusy()" :aria-busy="nextBusy()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Next</button>
        </div>
      </div>
    </section>
  </div>
</main>
