<script client>
/**
 * Sending domains, through the application's own API.
 *
 * This page was the `domains` area of `WorkspaceSurface`: four verified
 * domains, "12/12" DNS checks and a TLS status, none of it recorded anywhere.
 * Underneath, nothing could add a domain or verify one, so every email
 * campaign failed where the send job requires a verified sending domain.
 *
 * It lists the workspace's domains, adds one as pending, shows the one TXT
 * record to publish, and asks the server to look for it. The server compares
 * DNS to the record it issued; nothing this page sends can mark a domain
 * verified. Removing a domain returns its senders to pending.
 *
 * It covers sending domains only, and proves who may send as one. It shows
 * no SPF, DKIM, DMARC or TLS results; `sending-query.ts` records why.
 *
 * Writes carry the CSRF token explicitly, read with `useCookie`, the
 * composable, since a client script may not reach for the DOM itself.
 */
import {
  domainDraftError,
  domainErrorMessage,
  domainPayload,
  DOMAINS_ENDPOINT,
  domainUrl,
  listErrorMessage,
  toDomainViews,
  verifyResultMessage,
  verifyUrl,
} from '../../data/sending-query'

const domains = state([])
const loading = state(true)
const errorText = state('')
const actionError = state('')
const actionNotice = state('')
/* The domain a check or removal is in flight for, so only its buttons are busy. */
const busyId = state(0)
/* The domain whose Remove has been pressed once and is waiting for the second. */
const confirmId = state(0)

const addOpen = state(false)
const addDomain = state('')
const saving = state(false)
const addError = state('')

const csrfToken = useCookie('X-CSRF-Token')

const showEmpty = derived(() => !loading() && !errorText() && domains().length === 0)
const showList = derived(() => !loading() && !errorText() && domains().length > 0)

async function load() {
  loading.set(true)
  errorText.set('')
  confirmId.set(0)
  try {
    const response = await fetch(DOMAINS_ENDPOINT, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
    if (!response.ok) {
      errorText.set(listErrorMessage(response.status, 'sending domains'))
      domains.set([])
      return
    }
    domains.set(toDomainViews(await response.json()))
  }
  catch {
    // A network failure, not a refusal: there is no status to explain.
    errorText.set('Sending domains could not be loaded. Check your connection and try again.')
    domains.set([])
  }
  finally {
    loading.set(false)
  }
}

function writeHeaders() {
  return {
    'Content-Type': 'application/json',
    'Accept': 'application/json',
    'X-CSRF-Token': csrfToken() || '',
  }
}

async function check(id, name) {
  if (busyId())
    return
  busyId.set(id)
  actionError.set('')
  actionNotice.set('')
  try {
    const response = await fetch(verifyUrl(id), { method: 'POST', credentials: 'same-origin', headers: writeHeaders() })
    if (response.ok)
      actionNotice.set(verifyResultMessage(await response.json(), name))
    else
      actionError.set(domainErrorMessage(response.status))
    await load()
  }
  catch {
    actionError.set('That domain could not be checked. Check your connection and try again.')
  }
  finally {
    busyId.set(0)
  }
}

function askRemove(id) {
  actionError.set('')
  actionNotice.set('')
  confirmId.set(id)
}

function cancelRemove() {
  confirmId.set(0)
}

async function remove(id) {
  if (busyId() || confirmId() !== id)
    return
  busyId.set(id)
  actionError.set('')
  actionNotice.set('')
  try {
    const response = await fetch(domainUrl(id), { method: 'DELETE', credentials: 'same-origin', headers: writeHeaders() })
    if (!response.ok)
      actionError.set(domainErrorMessage(response.status))
    await load()
  }
  catch {
    actionError.set('That domain could not be removed. Check your connection and try again.')
  }
  finally {
    busyId.set(0)
  }
}

function toggleAdd() {
  addOpen.update(value => !value)
  addError.set('')
}

async function addOne() {
  const problem = domainDraftError(addDomain())
  if (problem) {
    addError.set(problem)
    return
  }

  saving.set(true)
  addError.set('')
  try {
    const response = await fetch(DOMAINS_ENDPOINT, {
      method: 'POST',
      credentials: 'same-origin',
      headers: writeHeaders(),
      body: JSON.stringify(domainPayload(addDomain())),
    })

    if (response.status === 201 || response.ok) {
      addDomain.set('')
      addOpen.set(false)
      await load()
      return
    }

    addError.set(domainErrorMessage(response.status))
  }
  catch {
    addError.set('The domain could not be added. Check your connection and try again.')
  }
  finally {
    saving.set(false)
  }
}

onMount(() => {
  void load()
})
</script>

<main id="main" class="p-5 sm:p-8 min-h-screen text-fg bg-page">
  <div class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-7">
      <div>
        <p class="font-bold text-[11px] text-accent tracking-[0.2em] uppercase">Domains</p>
        <h1 class="mt-2 font-semibold text-4xl tracking-[-0.04em]">Make every address unmistakably yours.</h1>
        <p class="mt-2 max-w-2xl text-fg-muted text-sm">The domains this workspace sends email from. A domain is verified by publishing one DNS record, which proves you control it. Email campaigns only go out from a verified domain.</p>
      </div>
      <div class="flex gap-2">
        <button type="button" @click="load()" :disabled="loading()" :aria-busy="loading()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Refresh</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Add domain</button>
      </div>
    </header>

    <section :if="addOpen()" class="mb-5 p-5 bg-panel border border-line rounded-panel" aria-labelledby="add-domain-title">
      <h2 id="add-domain-title" class="font-bold text-sm">Add a sending domain</h2>
      <p class="mt-1 text-fg-muted text-xs">It is added as waiting. You will get one TXT record to publish in the domain's DNS.</p>
      <label class="block mt-4 max-w-xl font-bold text-xs">
        Domain
        <input x-model.trim="addDomain" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="253" class="mt-1 field" placeholder="mail.example.com">
      </label>
      <p :if="addError()" class="mt-3 font-bold text-danger text-xs" role="alert">{{ addError() }}</p>
      <div class="flex gap-2 mt-4">
        <button type="button" @click="addOne()" :disabled="saving()" :aria-busy="saving()" class="px-5 min-h-11 font-bold text-[var(--coral-ink)] text-sm bg-accent rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Add domain</button>
        <button type="button" @click="toggleAdd()" class="px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2">Cancel</button>
      </div>
    </section>

    <p :if="actionError()" class="mb-5 p-4 font-bold text-danger text-sm bg-panel border border-line rounded-panel" role="alert">{{ actionError() }}</p>
    <p :if="actionNotice()" class="mb-5 p-4 font-bold text-sm bg-panel border border-line rounded-panel" role="status">{{ actionNotice() }}</p>

    <section class="overflow-hidden bg-panel border border-line rounded-panel" aria-labelledby="domains-title">
      <div class="p-5 border-b border-line">
        <h2 id="domains-title" class="font-bold">Sending domains</h2>
      </div>

      {{-- Loading. A row-shaped skeleton rather than a spinner, so the list
           does not jump height when the rows land. --}}
      <div :if="loading()" class="p-5 space-y-3" aria-hidden="true">
        <div class="h-16 bg-surface-sunken rounded-control"></div>
        <div class="h-16 bg-surface-sunken rounded-control"></div>
      </div>
      <p :if="loading()" class="sr-only" role="status">Loading sending domains</p>

      <div :if="errorText()" class="p-8 text-center" role="alert">
        <span aria-hidden="true" class="inline-block h-6 w-6 text-danger i-hugeicons-alert-02"></span>
        <p class="mt-3 font-bold text-sm">{{ errorText() }}</p>
        <button type="button" @click="load()" :disabled="loading()" :aria-busy="loading()" class="mt-4 px-5 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60">Try again</button>
      </div>

      <div :if="showEmpty()" class="p-10 text-center">
        <span aria-hidden="true" class="inline-block h-7 w-7 text-fg-muted i-hugeicons-global"></span>
        <p class="mt-3 font-bold">No sending domains yet.</p>
        <p class="mt-1 text-fg-muted text-sm">Add the domain your email comes from. Until one is verified, email campaigns cannot be delivered.</p>
      </div>

      <div :if="showList()" class="divide-line divide-y">
        <template :for="domain in domains()">
          <article class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between p-5">
            <div class="min-w-0">
              <h3 class="font-bold text-sm">{{ domain.domain }}</h3>
              <p class="mt-0.5 text-fg-muted text-xs">{{ domain.statusLabel }}. {{ domain.checkedLabel }}.</p>
              <dl :if="domain.recordHost" class="grid gap-x-4 gap-y-1 sm:grid-cols-[auto_1fr] mt-3 p-3 text-xs bg-surface-sunken rounded-control">
                <dt class="font-bold">Type</dt>
                <dd class="m-0">TXT</dd>
                <dt class="font-bold">Name</dt>
                <dd class="m-0 break-all"><code>{{ domain.recordHost }}</code></dd>
                <dt class="font-bold">Value</dt>
                <dd class="m-0 break-all"><code>{{ domain.recordValue }}</code></dd>
              </dl>
              <p :if="domain.recordHost" class="mt-2 text-fg-muted text-xs">Publish this record where the domain's DNS is managed, then check it.</p>
            </div>
            <div :if="confirmId() !== domain.id" class="flex flex-wrap gap-2 shrink-0">
              <button :if="!domain.verified" type="button" @click="check(domain.id, domain.domain)" :disabled="busyId() !== 0" :aria-busy="busyId() === domain.id" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Check DNS</button>
              <button type="button" @click="askRemove(domain.id)" :disabled="busyId() !== 0" :aria-busy="busyId() === domain.id" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Remove</button>
            </div>
            <div :if="confirmId() === domain.id" class="flex flex-col gap-2 shrink-0" role="group" aria-label="Confirm removal">
              <p class="m-0 font-bold text-xs">Remove {{ domain.domain }}? Its senders stop being verified.</p>
              <div class="flex gap-2">
                <button type="button" @click="remove(domain.id)" :disabled="busyId() !== 0" :aria-busy="busyId() === domain.id" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Yes, remove it</button>
                <button type="button" @click="cancelRemove()" class="px-4 min-h-11 font-bold text-fg text-sm bg-panel hover:bg-surface-hover border border-line rounded-pill focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 disabled:opacity-50">Keep it</button>
              </div>
            </div>
          </article>
        </template>
      </div>
    </section>
  </div>
</main>
