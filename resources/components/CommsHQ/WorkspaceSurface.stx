    metrics: [{ label: 'Active members', value: '7', note: '3 seats available' }, { label: 'Pending invites', value: '2', note: 'Expire in 4 days' }, { label: 'Protected actions', value: '14', note: 'Owner approval' }],
    records: [{ name: 'Maya Alvarez', detail: 'Owner, all permissions', status: 'Active', value: 'Now' }, { name: 'Elliot Chen', detail: 'Marketing and automations', status: 'Active', value: '18 min' }, { name: 'Priya Shah', detail: 'Publishing and analytics', status: 'Active', value: '2 hr' }],
