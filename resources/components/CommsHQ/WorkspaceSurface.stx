    records: [{ name: 'sundaypaper.co', detail: 'Publication and email', status: 'Verified', value: 'Primary' }, { name: 'notes.sundaypaper.co', detail: 'Publication domain', status: 'Verified', value: 'TLS active' }, { name: 'mail.sundaypaper.co', detail: 'Return path and tracking', status: 'Verified', value: 'Aligned' }],
