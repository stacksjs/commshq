  billing: {
    eyebrow: 'Billing and usage', title: 'Know what you use before the invoice arrives.', description: 'Review plan entitlements, contact and delivery usage, SMS costs, AI costs, platform fees, and overages.', primary: 'Manage plan', icon: 'i-hugeicons-credit-card',
    metrics: [{ label: 'Current plan', value: 'Business', note: '$99 monthly' }, { label: 'Email usage', value: '84,219', note: '34% of 250,000' }, { label: 'Contacts', value: '24,816', note: '99% of 25,000' }],
    records: [{ name: 'Business subscription', detail: 'Renews September 1', status: 'Active', value: '$99.00' }, { name: 'SMS carrier usage', detail: 'Twilio cost plus 15 percent', status: 'Metered', value: '$84.18' }, { name: 'Bedrock generation', detail: '612 of 5,000 generations', status: 'Metered', value: '$9.42' }],
    checklist: [{ label: 'Usage alerts', detail: 'Notify at 75, 90, and 100 percent', state: 'On' }, { label: 'Invoice delivery', detail: 'billing@sundaypaper.co', state: 'Ready' }, { label: 'Payment method', detail: 'Visa ending 4242', state: 'Healthy' }],
