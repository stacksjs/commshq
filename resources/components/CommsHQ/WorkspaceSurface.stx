<script client>
interface WorkspacePage {
  eyebrow: string
  title: string
  description: string
  primary: string
  icon: string
  metrics: Array<{ label: string, value: string, note: string }>
  records: Array<{ name: string, detail: string, status: string, value: string }>
  checklist: Array<{ label: string, detail: string, state: string }>
}

const area = useReactiveProp('area', 'onboarding')

const pages: Record<string, WorkspacePage> = {
  onboarding: {
    eyebrow: 'Start here', title: 'Set up a sending home that is ready to grow.', description: 'Connect a domain, confirm consent defaults, import your first audience, and publish one useful welcome.', primary: 'Continue setup', icon: 'i-hugeicons-rocket-02',
    metrics: [{ label: 'Setup complete', value: '63%', note: '5 of 8 steps' }, { label: 'Imported contacts', value: '1,248', note: 'All mapped' }, { label: 'Sender health', value: 'Ready', note: 'SPF and DKIM pass' }],
    records: [{ name: 'Create Sunday Paper Co.', detail: 'Workspace and owner configured', status: 'Complete', value: '1 min' }, { name: 'Verify sending domain', detail: 'sundaypaper.co', status: 'Complete', value: '4 min' }, { name: 'Send first welcome', detail: 'Review content and audience', status: 'Next', value: '8 min' }],
    checklist: [{ label: 'Double opt-in', detail: 'Required by default for new email contacts', state: 'On' }, { label: 'SMS consent', detail: 'Explicit written consent is required', state: 'On' }, { label: 'Quiet hours', detail: 'Recipient timezone enforcement', state: 'On' }],
  },
  sites: {
    eyebrow: 'Sites', title: 'Every publication deserves a true address.', description: 'Manage native Stacks sites, customer domains, TLS, redirects, menus, and isolated draft rendering.', primary: 'Create site', icon: 'i-hugeicons-web-design-02',
    metrics: [{ label: 'Live sites', value: '3', note: '2 custom domains' }, { label: 'TLS coverage', value: '100%', note: 'Auto-renewing' }, { label: 'Redirect health', value: '99.9%', note: 'No loops found' }],
    records: [{ name: 'Sunday Paper', detail: 'sundaypaper.co', status: 'Live', value: 'Primary' }, { name: 'Field Notes', detail: 'notes.sundaypaper.co', status: 'Live', value: 'Subdomain' }, { name: 'Spring launch', detail: 'Preview is team-only', status: 'Draft', value: 'Private' }],
    checklist: [{ label: 'Draft isolation', detail: 'Anonymous requests cannot resolve drafts', state: 'Locked' }, { label: 'Certificate renewal', detail: '42 days remaining', state: 'Healthy' }, { label: 'Canonical URLs', detail: 'All pages resolve one origin', state: 'Ready' }],
  },
  publications: {
    eyebrow: 'Publishing', title: 'Publish the archive people return to.', description: 'Run newsletters, blogs, gated posts, podcasts, feeds, menus, revisions, and scheduled releases together.', primary: 'Create post', icon: 'i-hugeicons-news-01',
    metrics: [{ label: 'Published posts', value: '148', note: '12 member-only' }, { label: 'Paid members', value: '2,184', note: '+9.6%' }, { label: 'Feed subscribers', value: '8,942', note: 'RSS and podcast' }],
    records: [{ name: 'A practice worth keeping', detail: 'Sunday Paper, issue 148', status: 'Scheduled', value: 'Aug 18' }, { name: 'Reader desk tours', detail: 'Paid member edition', status: 'Draft', value: 'v6' }, { name: 'Studio Notes 24', detail: 'Podcast episode and transcript', status: 'Live', value: '42 min' }],
    checklist: [{ label: 'Revision history', detail: 'Every publish creates an immutable revision', state: 'Ready' }, { label: 'RSS-to-send', detail: 'Approval required before campaign creation', state: 'On' }, { label: 'SEO checks', detail: 'Metadata and social preview complete', state: 'Ready' }],
  },
  commerce: {
    eyebrow: 'Commerce marketing', title: 'Turn store moments into thoughtful follow-up.', description: 'Normalize carts, purchases, subscriptions, and product activity before attribution or automation runs.', primary: 'Connect store', icon: 'i-hugeicons-shopping-bag-02',
    metrics: [{ label: 'Attributed revenue', value: '$84,620', note: '+12.7%' }, { label: 'Recovered carts', value: '318', note: '$26,418 recovered' }, { label: 'Commerce events', value: '1.8M', note: 'No duplicates' }],
    records: [{ name: 'Primary Shopify store', detail: 'Orders, carts, products, customers', status: 'Healthy', value: 'Live' }, { name: 'Stripe subscriptions', detail: 'Plans and invoice activity', status: 'Healthy', value: 'Live' }, { name: 'Wholesale CSV', detail: 'Nightly signed import', status: 'Review', value: '2 rows' }],
    checklist: [{ label: 'Signature checks', detail: 'Every provider webhook is verified', state: 'Locked' }, { label: 'Event ledger', detail: 'Immutable normalized events', state: 'Healthy' }, { label: 'Replay safety', detail: 'Idempotency keys retained', state: 'On' }],
  },
  monetization: {
    eyebrow: 'Monetization', title: 'Earn without losing the reader’s trust.', description: 'Manage paid publications, referrals, recommendations, sponsors, inventory, commissions, and payouts clearly.', primary: 'Create offer', icon: 'i-hugeicons-money-receive-circle',
    metrics: [{ label: 'Net earnings', value: '$31,842', note: 'This month' }, { label: 'Sponsor fill rate', value: '72%', note: '+8 points' }, { label: 'Referral earnings', value: '$4,218', note: '1,684 conversions' }],
    records: [{ name: 'Studio Supply Co.', detail: 'Primary newsletter placement', status: 'Approved', value: '$4,800' }, { name: 'Field Guide exchange', detail: 'Recommendation partnership', status: 'Live', value: '$1.80 CPA' }, { name: 'August creator payout', detail: 'ACH account ending 1842', status: 'Scheduled', value: '$18,406' }],
    checklist: [{ label: 'Disclosure copy', detail: 'Present on every sponsored placement', state: 'Ready' }, { label: 'Commission ledger', detail: 'Append-only accounting entries', state: 'Locked' }, { label: 'Payout review', detail: 'Owner approval is required', state: 'On' }],
  },
  analytics: {
    eyebrow: 'First-party analytics', title: 'See the path from attention to revenue.', description: 'Measure acquisition, engagement, automations, referrals, cohorts, retention, attribution, and lifetime value.', primary: 'Create report', icon: 'i-hugeicons-chart-line-data-02',
    metrics: [{ label: 'Known visitors', value: '68.4%', note: '+4.2 points' }, { label: '30-day retention', value: '71.2%', note: '+2.8 points' }, { label: 'Reader LTV', value: '$48.20', note: '+$6.14' }],
    records: [{ name: 'Organic publication', detail: 'Search, direct, and RSS', status: 'Leading', value: '$28,412' }, { name: 'Reader referrals', detail: 'Verified recommendation links', status: 'Growing', value: '$18,920' }, { name: 'Commerce recovery', detail: 'Cart and win-back journeys', status: 'Efficient', value: '8.4x ROAS' }],
    checklist: [{ label: 'Attribution model', detail: 'First-party position based', state: 'Active' }, { label: 'Bot filtering', detail: 'Known agents and abnormal events removed', state: 'Healthy' }, { label: 'Export controls', detail: 'Workspace permissions required', state: 'Locked' }],
  },
  teams: {
    eyebrow: 'Team and access', title: 'Give every collaborator the right room to work.', description: 'Manage workspace members, roles, invitations, gates, approvals, active sessions, and auditable administration.', primary: 'Invite member', icon: 'i-hugeicons-shield-user',
    metrics: [{ label: 'Active members', value: '7', note: '3 seats available' }, { label: 'Pending invites', value: '2', note: 'Expire in 4 days' }, { label: 'Protected actions', value: '14', note: 'Owner approval' }],
    records: [{ name: 'Maya Alvarez', detail: 'Owner, all permissions', status: 'Active', value: 'Now' }, { name: 'Elliot Chen', detail: 'Marketing and automations', status: 'Active', value: '18 min' }, { name: 'Priya Shah', detail: 'Publishing and analytics', status: 'Active', value: '2 hr' }],
    checklist: [{ label: 'Multi-factor auth', detail: 'Required for owners and administrators', state: 'On' }, { label: 'Session review', detail: 'No unrecognized sessions', state: 'Healthy' }, { label: 'Audit trail', detail: 'Admin actions are append-only', state: 'Locked' }],
  },
  settings: {
    eyebrow: 'Workspace settings', title: 'Set the defaults that keep work consistent.', description: 'Configure identity, locale, compliance, approvals, retention, AI quotas, notifications, and workspace ownership.', primary: 'Save settings', icon: 'i-hugeicons-settings-02',
    metrics: [{ label: 'Configuration health', value: '98%', note: '1 recommendation' }, { label: 'Policy version', value: '2026.2', note: 'Current' }, { label: 'Retention rules', value: '6', note: 'All active' }],
    records: [{ name: 'Workspace identity', detail: 'Sunday Paper Co., America/Los_Angeles', status: 'Complete', value: 'US' }, { name: 'Consent defaults', detail: 'Double opt-in and written SMS consent', status: 'Strict', value: 'Global' }, { name: 'AI publishing policy', detail: 'Human approval required', status: 'Enabled', value: 'All channels' }],
    checklist: [{ label: 'Data minimization', detail: 'Unused metadata expires automatically', state: 'On' }, { label: 'Approval policy', detail: 'AI and high-risk sends require review', state: 'On' }, { label: 'Owner recovery', detail: 'Recovery contacts are verified', state: 'Ready' }],
  },
}

const page = computed(() => pages[area()] || pages.onboarding)
const viewState = state('populated')
</script>

<main id="main" class="px-4 py-5 sm:px-6 lg:px-9 lg:py-8 min-h-screen text-[#171916] dark:text-[#f5f2ec] bg-[#f6f3ee] dark:bg-[#111210]">
  <div class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between pb-7 border-[#171916]/10 border-b dark:border-white/10">
      <div class="max-w-4xl">
        <p class="mb-2 font-bold text-[#e65743] text-[11px] tracking-[0.2em] uppercase">{{ page().eyebrow }}</p>
        <h1 class="font-semibold text-3xl text-balance tracking-[-0.04em] sm:text-4xl">{{ page().title }}</h1>
        <p class="mt-3 max-w-2xl leading-6 text-[#686b65] text-sm dark:text-[#aaa9a3]">{{ page().description }}</p>
      </div>
      <button type="button" class="inline-flex gap-2 items-center justify-center shrink-0 px-5 min-h-11 font-bold text-sm text-white bg-[#e65743] rounded-full focus-visible:outline focus-visible:outline-[#e65743] focus-visible:outline-2 focus-visible:outline-offset-2 shadow-[0_8px_24px_rgba(230,87,67,0.18)] transition-transform hover:-translate-y-0.5">
        <span aria-hidden="true" class="h-4 w-4 {{ page().icon }}"></span>{{ page().primary }}
      </button>
    </header>

    <section class="py-7" aria-labelledby="overview-title">
      <div class="flex flex-wrap gap-3 items-center justify-between mb-4">
        <h2 id="overview-title" class="font-bold text-sm">Workspace overview</h2>
        <div class="flex flex-wrap p-1 font-bold text-[11px] bg-white/70 dark:bg-white/5 border border-[#171916]/10 rounded-full dark:border-white/10" aria-label="Preview interface states">
          @foreach([{ key: 'populated', label: 'Live' }, { key: 'loading', label: 'Loading' }, { key: 'empty', label: 'Empty' }, { key: 'error', label: 'Error' }] as stateOption)
            <button type="button" @click="viewState.set('{{ stateOption.key }}')" class="px-3 min-h-8 rounded-full" :class="viewState() === '{{ stateOption.key }}' ? 'bg-[#1c201b] text-white dark:bg-white dark:text-[#171916]' : 'text-[#6c6f68] dark:text-[#aaa9a3]'">{{ stateOption.label }}</button>
          @endforeach
        </div>
      </div>

      <div :if="viewState() === 'loading'" role="status" aria-live="polite" class="grid gap-3 sm:grid-cols-3">
        @foreach([1, 2, 3] as placeholder)
          <div class="p-5 min-h-32 bg-white/60 dark:bg-white/5 border border-[#171916]/10 rounded-[1.4rem] dark:border-white/10 animate-pulse"><span class="block h-3 w-24 bg-black/10 dark:bg-white/10 rounded"></span><span class="block mt-7 h-8 w-32 bg-black/10 dark:bg-white/10 rounded"></span></div>
        @endforeach
        <span class="sr-only">Loading workspace data</span>
      </div>
      <div :if="viewState() === 'empty'" class="px-6 py-16 text-center bg-white/60 dark:bg-white/[0.03] border border-[#171916]/20 border-dashed rounded-[1.6rem] dark:border-white/20">
        <span aria-hidden="true" class="mx-auto block h-8 w-8 text-[#e65743] {{ page().icon }}"></span><h3 class="mt-4 font-bold text-lg">Nothing here yet</h3><p class="mt-2 mx-auto max-w-md text-[#6c6f68] text-sm dark:text-[#aaa9a3]">Create the first record or connect a source. CommsHQ will keep this space useful as activity arrives.</p>
      </div>
      <div :if="viewState() === 'error'" role="alert" class="px-6 py-12 text-[#8f3025] text-center dark:text-[#ffab9a] bg-[#fff0eb] dark:bg-[#e65743]/10 border border-[#efb1a5] rounded-[1.6rem] dark:border-[#e65743]/30">
        <span aria-hidden="true" class="block mx-auto h-8 w-8 i-hugeicons-alert-02"></span><h3 class="mt-4 font-bold text-lg">This view could not be refreshed</h3><p class="mt-2 mx-auto max-w-md text-sm">Your last known data is safe. Retry when the connection is available.</p><button type="button" @click="viewState.set('populated')" class="mt-5 px-4 min-h-10 font-bold text-xs border border-current rounded-full">Retry</button>
      </div>
      <div :if="viewState() === 'populated'" class="grid gap-3 sm:grid-cols-3">
        @foreach(page().metrics as metric)
          <article class="p-5 bg-white/75 dark:bg-white/[0.04] border border-[#171916]/10 rounded-[1.4rem] dark:border-white/10 shadow-[0_1px_0_rgba(23,25,22,0.04)]"><p class="text-[#6c6f68] text-xs dark:text-[#aaa9a3]">{{ metric.label }}</p><p class="mt-5 font-semibold text-3xl tracking-[-0.04em]">{{ metric.value }}</p><p class="mt-2 font-bold text-[#4f7538] text-xs dark:text-[#acd294]">{{ metric.note }}</p></article>
        @endforeach
      </div>
    </section>

    <div :if="viewState() === 'populated'" class="grid gap-5 xl:grid-cols-[1.4fr_0.8fr]">
      <section class="overflow-hidden bg-white/80 dark:bg-white/[0.04] border border-[#171916]/10 rounded-[1.6rem] dark:border-white/10" aria-labelledby="records-title">
        <div class="flex items-center justify-between px-5 py-4 border-[#171916]/10 border-b dark:border-white/10"><h2 id="records-title" class="font-bold text-sm">Active work</h2><button type="button" aria-label="Filter records" class="p-2 text-[#6c6f68] dark:text-[#aaa9a3] hover:bg-black/5 dark:hover:bg-white/10 rounded-full"><span aria-hidden="true" class="block h-4 w-4 i-hugeicons-filter-horizontal"></span></button></div>
        <div class="divide-[#171916]/8 divide-y dark:divide-white/8">
          @foreach(page().records as record)
            <article class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-center px-5 py-5"><div><div class="flex flex-wrap gap-2 items-center"><h3 class="font-bold text-sm">{{ record.name }}</h3><Badge size="sm" className="workspace-record-badge">{{ record.status }}</Badge></div><p class="mt-1 leading-5 text-[#6c6f68] text-xs dark:text-[#aaa9a3]">{{ record.detail }}</p></div><p class="font-bold text-sm">{{ record.value }}</p></article>
          @endforeach
        </div>
      </section>

      <aside class="p-6 text-white bg-[#1c201b] rounded-[1.6rem] shadow-[0_22px_70px_rgba(23,25,22,0.12)]" aria-labelledby="checks-title">
        <div class="flex items-center justify-between"><h2 id="checks-title" class="font-bold text-sm">Readiness checks</h2><span aria-hidden="true" class="h-5 w-5 text-[#ff8c79] i-hugeicons-shield-02"></span></div>
        <div class="mt-5 space-y-1">
          @foreach(page().checklist as check)
            <div class="py-4 border-b border-white/10 last:border-0"><div class="flex gap-4 items-start justify-between"><p class="font-bold text-sm">{{ check.label }}</p><Badge size="sm" className="workspace-check-badge">{{ check.state }}</Badge></div><p class="mt-1 leading-5 text-white/55 text-xs">{{ check.detail }}</p></div>
          @endforeach
        </div>
      </aside>
    </div>
  </div>
</main>
