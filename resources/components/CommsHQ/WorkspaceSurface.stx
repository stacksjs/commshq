  },
  analytics: {
    eyebrow: 'First-party analytics', title: 'See the path from attention to revenue.', description: 'Measure acquisition, engagement, automations, referrals, cohorts, retention, attribution, and lifetime value.', primary: 'Create report', icon: 'i-hugeicons-chart-line-data-02',
    metrics: [{ label: 'Known visitors', value: '68.4%', note: '+4.2 points' }, { label: '30-day retention', value: '71.2%', note: '+2.8 points' }, { label: 'Reader LTV', value: '$48.20', note: '+$6.14' }],
    records: [{ name: 'Organic publication', detail: 'Search, direct, and RSS', status: 'Leading', value: '$28,412' }, { name: 'Reader referrals', detail: 'Verified recommendation links', status: 'Growing', value: '$18,920' }, { name: 'Commerce recovery', detail: 'Cart and win-back journeys', status: 'Efficient', value: '8.4x ROAS' }],
    checklist: [{ label: 'Attribution model', detail: 'First-party position based', state: 'Active' }, { label: 'Bot filtering', detail: 'Known agents and abnormal events removed', state: 'Healthy' }, { label: 'Export controls', detail: 'Workspace permissions required', state: 'Locked' }],
  },
  integrations: {
    eyebrow: 'Integrations', title: 'Connect the systems that carry the work.', description: 'Manage mail, SMS, commerce, billing, AI, and customer webhooks with encrypted credentials and diagnostics.', primary: 'Add integration', icon: 'i-hugeicons-plug-socket',
    metrics: [{ label: 'Connected services', value: '7', note: 'All owned or native' }, { label: 'Webhook success', value: '99.98%', note: 'Last 7 days' }, { label: 'Pending replays', value: '0', note: 'Queue is clear' }],
    records: [{ name: 'CommsHQ Mail', detail: 'SMTP, bounces, complaints, DKIM', status: 'Healthy', value: '12 ms' }, { name: 'Twilio messaging', detail: 'Outbound, inbound, delivery status', status: 'Healthy', value: '86 ms' }, { name: 'AWS Bedrock', detail: 'Draft assistance with provenance', status: 'Healthy', value: '420 ms' }],
