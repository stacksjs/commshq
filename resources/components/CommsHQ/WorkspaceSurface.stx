    metrics: [{ label: 'Net earnings', value: '$31,842', note: 'This month' }, { label: 'Sponsor fill rate', value: '72%', note: '+8 points' }, { label: 'Referral earnings', value: '$4,218', note: '1,684 conversions' }],
