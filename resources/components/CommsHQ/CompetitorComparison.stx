<script server>
interface CompetitorComparisonProps { competitor?: string }
interface ComparisonRow { dimension: string, commshq: string, rival: string }
interface ComparisonPage {
  name: string
  category: string
  intro: string
  /** Stated plainly and first, because a comparison that never concedes anything is not worth reading. */
  strengths: Array<{ title: string, text: string }>
  differences: Array<{ title: string, text: string }>
  rows: ComparisonRow[]
  chooseRival: string
  chooseCommsHQ: string
  verify: string
}

const props = defineProps<CompetitorComparisonProps>()

/**
 * Every page states what the other product is genuinely good at before it states
 * where CommsHQ differs, and describes rivals structurally rather than by price
 * or plan limits, which change without notice. Anything a reader would act on
 * should be confirmed against the vendor's own site, which every page links to.
 */
const REVIEWED = 'August 2026'

