      <section id="pricing" class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div><p class="coral text-xs font-bold uppercase tracking-[0.22em]">Simple pricing</p><h2 class="ink mt-4 text-4xl tracking-[-0.035em] sm:text-5xl">Start free. Grow on your terms.</h2></div>
          <p class="muted max-w-md leading-7">No transaction fee on connected-store sales. Paid publishing and network fees are clear before you earn.</p>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          @foreach(plans as plan)
