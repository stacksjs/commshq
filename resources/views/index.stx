              <p class="mt-7"><span class="ink text-5xl font-bold tracking-tight">{{ plan.price }}</span><span class="muted"> / month</span></p>
              <p class="muted min-h-14 leading-7">{{ plan.note }}</p>
              <ul class="mt-7 space-y-3 p-0">
                @foreach(plan.features as item)
                  <li class="ink flex items-center gap-3 text-sm"><span class="i-hugeicons-tick-02 coral h-4 w-4" aria-hidden="true"></span>{{ item }}</li>
                @endforeach
              </ul>
              <a href="/dashboard/register" class="ink mt-auto inline-flex min-h-11 items-center justify-center rounded-md border border-tone px-5 font-semibold focus:outline-none focus:ring-2 focus:ring-offset-2">Choose {{ plan.name }}</a>
            </article>
          @endforeach
