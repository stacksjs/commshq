      .paper { background: var(--paper); }
      .panel { background: var(--panel); }
      .ink { color: var(--ink); }
      .muted { color: var(--muted); }
      .coral { color: var(--coral); }
      .bg-coral { background: var(--coral); }
      .border-tone { border-color: var(--line); }
      .text-balance { text-wrap: balance; }
      .editorial-grid { background-image: linear-gradient(to right, color-mix(in srgb, var(--line) 45%, transparent) 1px, transparent 1px); background-size: min(8vw, 6rem) 100%; }
      .reveal { animation: reveal 700ms both; animation-timeline: view(); animation-range: entry 8% cover 28%; }
      @keyframes reveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .reveal { animation: none; } }
    </style>
  </head>
