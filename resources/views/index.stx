          <figure class="relative m-0 lg:-mr-16">
            <div class="overflow-hidden border border-tone rounded-[2rem] shadow-2xl">
              <img src="/images/commshq-editorial-hero.png" alt="A coral mailer, notebook, phone, and editorial cards arranged on a warm studio table" class="object-cover h-full min-h-[420px] w-full" width="1536" height="1024">
            </div>
            <figcaption class="absolute left-5 px-4 py-3 font-semibold text-sm border border-tone rounded-md shadow-lg -bottom-6 panel">One idea, every channel, one clear story.</figcaption>
          </figure>
        </div>
      </section>

      <section aria-label="Customer results" class="border-b border-tone">
        <div class="grid md:grid-cols-3 mx-auto px-5 lg:px-8 max-w-7xl divide-tone divide-y md:divide-x md:divide-y-0">
          @foreach(channelStats as stat)
            <div class="py-8 md:px-8 md:first:pl-0">
              <p class="m-0 font-bold text-3xl ink">{{ stat.value }}</p>
              <p class="mb-0 mt-1 text-sm muted">{{ stat.label }}</p>
            </div>
          @endforeach
        </div>
