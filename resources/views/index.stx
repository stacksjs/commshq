          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="font-bold text-xs tracking-[0.22em] uppercase coral">The connected path</p>
            <h2 class="mt-4 leading-tight text-4xl text-balance tracking-[-0.035em] sm:text-5xl ink">From first hello to favorite customer.</h2>
            <p class="mt-5 max-w-md leading-8 text-lg muted">Every interaction adds useful context, with consent and tenant boundaries enforced at the data layer.</p>
          </div>
          <ol class="m-0 p-0 space-y-4">
            @foreach(workflow as step)
              <li class="grid gap-5 sm:grid-cols-[auto_1fr] p-7 sm:p-9 border border-tone rounded-xl panel reveal">
                <span class="coral {{ step.icon }} mt-1 h-7 w-7" aria-hidden="true"></span>
                <div><h3 class="m-0 text-2xl ink">{{ step.title }}</h3><p class="mb-0 mt-3 leading-7 muted">{{ step.text }}</p></div>
              </li>
            @endforeach
