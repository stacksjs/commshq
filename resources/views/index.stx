            <p class="font-bold text-xs tracking-[0.22em] uppercase coral">A complete creative system</p>
            <h2 class="mt-4 leading-tight text-4xl text-balance tracking-[-0.035em] sm:text-5xl ink">Create the message. Publish the story. Measure the business.</h2>
          </div>
          <div class="grid overflow-hidden gap-px md:grid-cols-2 mt-14 bg-[var(--line)] border border-tone rounded-xl">
            @foreach(features as feature)
              <article class="flex flex-col p-8 sm:p-10 min-h-72 paper reveal">
                <div class="flex items-center justify-between"><span class="font-bold text-xs tracking-[0.18em] uppercase coral">{{ feature.eyebrow }}</span><span class="coral {{ feature.icon }} h-6 w-6" aria-hidden="true"></span></div>
                <h3 class="mt-12 leading-tight text-3xl text-balance ink">{{ feature.title }}</h3>
                <p class="mb-0 mt-4 max-w-lg leading-7 muted">{{ feature.text }}</p>
                <a href="{{ feature.href }}" class="inline-flex gap-2 items-center mt-auto pt-8 font-bold coral">Explore {{ feature.eyebrow }}<span class="h-4 w-4 i-hugeicons-arrow-right-02" aria-hidden="true"></span></a>
              </article>
            @endforeach
          </div>
        </div>
      </section>

      <section id="pricing" class="mx-auto px-5 py-24 lg:px-8 lg:py-32 max-w-7xl">
        <div class="flex flex-col gap-6 justify-between md:flex-row md:items-end">
          <div><p class="font-bold text-xs tracking-[0.22em] uppercase coral">Simple pricing</p><h2 class="mt-4 text-4xl tracking-[-0.035em] sm:text-5xl ink">Start free. Grow on your terms.</h2></div>
          <p class="max-w-md leading-7 muted">No transaction fee on connected-store sales. Paid publishing and network fees are clear before you earn.</p>
        </div>
        <div class="grid gap-5 lg:grid-cols-3 mt-12">
          @foreach(plans as plan)
            <article class="flex flex-col p-8 min-h-[430px] border border-tone rounded-xl panel reveal">
              <h3 class="m-0 text-2xl ink">{{ plan.name }}</h3>
              <p class="mt-7"><span class="font-bold text-5xl tracking-tight ink">{{ plan.price }}</span><span class="muted"> / month</span></p>
              <p class="min-h-14 leading-7 muted">{{ plan.note }}</p>
              <ul class="mt-7 p-0 space-y-3">
                @foreach(plan.features as item)
                  <li class="flex gap-3 items-center text-sm ink"><span class="h-4 w-4 coral i-hugeicons-tick-02" aria-hidden="true"></span>{{ item }}</li>
                @endforeach
              </ul>
              <a href="/register" class="inline-flex items-center justify-center mt-auto px-5 min-h-11 font-semibold border border-tone rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 ink">Choose {{ plan.name }}</a>
            </article>
          @endforeach
        </div>
      </section>

      <section class="py-20 text-white bg-coral">
        <div class="flex flex-col gap-8 items-start justify-between md:flex-row md:items-center mx-auto px-5 lg:px-8 max-w-7xl">
          <div><p class="mb-3 font-bold text-white/75 text-xs tracking-[0.22em] uppercase">Your next send starts here</p><h2 class="m-0 max-w-3xl leading-tight text-4xl text-balance sm:text-5xl">Build a communications home your audience can feel.</h2></div>
          <a href="/register" class="inline-flex items-center justify-center shrink-0 px-6 min-h-12 font-bold text-[#c73e2c] bg-white rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white">Start with CommsHQ</a>
        </div>
