<script server>
const channelStats = [
  { value: 'Email + SMS', label: 'coordinated through one delivery history' },
  { value: 'One ledger', label: 'consent proof across every audience source' },
  { value: '0%', label: 'CommsHQ fee on connected-store sales' },
]

const workflow = [
  { icon: 'i-hugeicons-user-multiple-02', title: 'Know every reader', text: 'One consent-aware audience across email, SMS, publishing, and purchases.' },
  { icon: 'i-hugeicons-flowchart-01', title: 'Build the journey', text: 'Shape branches, delays, experiments, and approvals in one visual workflow.' },
  { icon: 'i-hugeicons-chart-evaluation', title: 'Learn what converts', text: 'Attribute the full path from first visit to renewal without third-party pixels.' },
]

const features = [
  { href: '/email', eyebrow: 'Email', title: 'Editorial sends that feel made by people', text: 'Compose with reusable blocks, conditional content, plain-text output, responsive previews, and deterministic experiments.', icon: 'i-hugeicons-mail-02' },
  { href: '/sms', eyebrow: 'SMS', title: 'Timely messages with consent built in', text: 'See segment counts, quiet-hour warnings, STOP language, consent status, and live delivery reporting before you send.', icon: 'i-hugeicons-message-02' },
  { href: '/publishing', eyebrow: 'Publishing', title: 'Your publication is part of the system', text: 'Launch archives, blogs, landing pages, gated posts, forms, podcasts, feeds, and custom domains from the same workspace.', icon: 'i-hugeicons-news-01' },
  { href: '/commerce', eyebrow: 'Commerce', title: 'Turn store signals into useful follow-up', text: 'Normalize purchase and cart events, then run recovery, replenishment, win-back, and product journeys with clear attribution.', icon: 'i-hugeicons-shopping-bag-02' },
]

const plans = [
  { name: 'Free', price: '$0', note: 'For a new idea finding its first thousand people.', features: ['1,000 contacts', '10,000 emails monthly', '1 publication', 'Forms and campaigns'] },
  { name: 'Creator', price: '$29', note: 'For independent publishers building a real business.', features: ['5,000 contacts', '50,000 emails monthly', 'Automations and paid content', '2 custom domains'] },
  { name: 'Business', price: '$99', note: 'For teams connecting audience and commerce.', features: ['25,000 contacts', '250,000 emails monthly', 'SMS and experiments', 'Commerce automation'] },
]
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
