<script server>
// Step one of a password reset: ask for the address.
//
// Before this page existed there was no way into a flow whose endpoints were
// already registered: login.stx offered no link, and /forgot-password answered
// 200 with the marketing homepage because the catch-all served it. A soft 404
// on an account recovery path is worse than a hard one, because it looks like
// the feature is there.
useSeoMeta({
  title: 'Reset your password - CommsHQ',
  description: 'Request a password reset link for your CommsHQ account.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// POST /password/forgot, then replace the form with a confirmation.
//
// ## Why every outcome except 429 reads the same
//
// SendPasswordResetEmailAction returns one constant on every path - known
// address, unknown address, and a send that threw - and keeps it in a single
// NEUTRAL_RESPONSE so a later branch cannot quietly undo that. This page must
// not undo it either: the branches a stranger can observe are what leaks, not
// the ones the server takes internally. It is the same reasoning the sign-in
// form uses when it answers "Incorrect email or password" without saying which.
//
// 429 is the exception and stays visible. A rate limit is a fact about the
// person asking rather than about whether somebody else has an account, and
// hiding it leaves them waiting on an email that was never queued.
const error: StxSignal<string> = state('')
const sent: StxSignal<boolean> = state(false)
const loading: StxSignal<boolean> = state(false)

/** What /password/forgot answers with. */
interface ForgotResponse {
  message?: string
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return

  const form = e.target as HTMLFormElement
  const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()

  loading.set(true)
  error.set('')

  try {
    const res = await fetch('/password/forgot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ email }),
    })

    if (res.status === 429) {
      const data = await res.json().catch(() => ({})) as ForgotResponse
      error.set(data.message || 'Too many attempts. Please try again in a few minutes.')
      return
    }

    sent.set(true)
  }
  catch {
    // A transport failure is about this request, not about the account, so it
    // is safe to name. Claiming "sent" here would cost somebody their recovery.
    error.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('auth')

@section('title', 'Reset your password - CommsHQ')

@section('content')
<div class="max-w-sm w-full">
  <div class="mb-8 text-center">
    <StxLink to="/" class="font-bold no-underline text-2xl ink">CommsHQ</StxLink>
    <p class="mt-2 text-sm muted">Reset your password</p>
  </div>

  <div class="px-6 py-7 border border-tone rounded-2xl panel">
    {{-- Confirmation and form are separate elements rather than one whose label
         changes: the form must not linger under a success message, and a second
         submit after a successful send is only another email. --}}
    <div :show="sent()">
      <p class="text-sm ink" role="status">
        If that email has an account, a reset link is on its way. The link is
        good for 60 minutes.
      </p>
      <p class="mt-5 text-center text-xs muted">
        <StxLink to="/login" class="font-medium ink">Back to sign in</StxLink>
      </p>
    </div>

    <form @submit="handleSubmit" class="space-y-4" :show="!sent()">
      <p class="text-sm muted">Enter the email you signed up with and we will send you a link to set a new password.</p>

      <div>
        <label for="email" class="block mb-1.5 font-medium text-xs ink">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" class="field" placeholder="you@example.com" :aria-invalid="error() ? 'true' : 'false'" :aria-describedby="error() ? 'forgot-error' : ''">
      </div>

      @if (error())
        <p id="forgot-error" class="text-[var(--coral)] text-sm" role="alert">{{ error() }}</p>
      @endif

      <button type="submit" :disabled="loading()" :aria-busy="loading()" class="px-4 py-2.5 w-full font-semibold text-[var(--coral-ink)] text-sm bg-coral border-0 rounded-xl cursor-pointer">{{ loading() ? 'Sending' : 'Send reset link' }}</button>

      <p class="text-center text-xs muted">
        Remembered it?
        <StxLink to="/login" class="font-medium ink">Sign in</StxLink>
      </p>
    </form>
  </div>
</div>
@endsection
