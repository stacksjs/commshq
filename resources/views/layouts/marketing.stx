<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@yield('description')">
    <meta name="theme-color" content="#f7f1ea">
    <title>@yield('title')</title>
    @appearanceBootstrap({ storageKey: 'commshq-appearance', appearance: { key: 'theme', attribute: 'appearance', allowed: ['editorial'], default: 'editorial' }, colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' } })
    <style>
      :root { --paper: #f7f1ea; --ink: #201d1a; --muted: #6f665e; --coral: #bd3e2e; --coral-ink: #ffffff; --line: #d9cec3; --panel: #fffaf5; color-scheme: light; }
      :root.dark { --paper: #191715; --ink: #f8f0e8; --muted: #b9aca1; --coral: #ff8a78; --coral-ink: #191715; --line: #403a35; --panel: #24211e; color-scheme: dark; }
      html { background: var(--paper); scroll-behavior: smooth; } body { margin: 0; background: var(--paper); color: var(--ink); font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; } h1, h2, h3 { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; }
      .paper { background: var(--paper); } .panel { background: var(--panel); } .ink { color: var(--ink); } .muted { color: var(--muted); } .coral { color: var(--coral); } .bg-coral { background: var(--coral); } .border-tone { border-color: var(--line); } .text-balance { text-wrap: balance; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
    @stack('head')
  </head>
  <body>
    <a href="#main" class="focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:px-4 focus:py-3 focus:text-white focus:bg-black focus:rounded-md sr-only focus:not-sr-only">Skip to content</a>
    <MarketingNavigation />
    <main id="main">@yield('content')</main>
    <footer class="border-t border-tone paper">
      <div class="mx-auto px-5 py-14 lg:px-8 max-w-7xl">
        <nav class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4" aria-label="Footer">
          <section>
            <h2 class="m-0 font-bold text-[11px] tracking-[0.18em] uppercase coral">Compare</h2>
            <ul class="m-0 mt-4 p-0 space-y-2 list-none text-sm">
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/mailchimp">vs Mailchimp</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/klaviyo">vs Klaviyo</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/kit">vs Kit</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/beehiiv">vs beehiiv</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/substack">vs Substack</StxLink></li>
              <li><StxLink class="font-semibold ink" to="/compare">All comparisons</StxLink></li>
            </ul>
          </section>
          <section>
            <h2 class="m-0 font-bold text-[11px] tracking-[0.18em] uppercase coral">Compare more</h2>
            <ul class="m-0 mt-4 p-0 space-y-2 list-none text-sm">
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/hubspot">vs HubSpot</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/activecampaign">vs ActiveCampaign</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/brevo">vs Brevo</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/customer-io">vs Customer.io</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/birdeye">vs Birdeye</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/compare/podium">vs Podium</StxLink></li>
            </ul>
          </section>
          <section>
            <h2 class="m-0 font-bold text-[11px] tracking-[0.18em] uppercase coral">Product</h2>
            <ul class="m-0 mt-4 p-0 space-y-2 list-none text-sm">
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/features">Features</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/solutions">Solutions</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/pricing">Pricing</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/integrations">Integrations</StxLink></li>
            </ul>
          </section>
          <section>
            <h2 class="m-0 font-bold text-[11px] tracking-[0.18em] uppercase coral">Company</h2>
            <ul class="m-0 mt-4 p-0 space-y-2 list-none text-sm">
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/security">Security</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/privacy">Privacy</StxLink></li>
              <li><StxLink class="hover:text-[var(--ink)] muted" to="/terms">Terms</StxLink></li>
            </ul>
          </section>
        </nav>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mt-12 pt-6 border-t border-tone">
          <StxLink to="/" class="font-bold ink">CommsHQ</StxLink>
          <p class="m-0 text-sm muted">Comparisons name other companies only to describe their products. All trademarks belong to their owners.</p>
          <p class="m-0 text-sm muted">Built with Stacks.</p>
        </div>
      </div>
    </footer>
    @stack('scripts')
  </body>
</html>
