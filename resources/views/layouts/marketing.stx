<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@yield('description')">
    <meta name="theme-color" content="#f7f1ea">
    <title>@yield('title')</title>
    @appearanceBootstrap({ storageKey: 'commshq-appearance', appearance: { key: 'theme', attribute: 'appearance', allowed: ['editorial'], default: 'editorial' }, colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' } })
    <style>
      :root { --paper: #f7f1ea; --ink: #201d1a; --muted: #6f665e; --coral: #e95843; --line: #d9cec3; --panel: #fffaf5; color-scheme: light; }
      :root.dark { --paper: #191715; --ink: #f8f0e8; --muted: #b9aca1; --coral: #ff745f; --line: #403a35; --panel: #24211e; color-scheme: dark; }
      html { background: var(--paper); scroll-behavior: smooth; } body { margin: 0; background: var(--paper); color: var(--ink); font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; } h1, h2, h3 { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; }
      .paper { background: var(--paper); } .panel { background: var(--panel); } .ink { color: var(--ink); } .muted { color: var(--muted); } .coral { color: var(--coral); } .bg-coral { background: var(--coral); } .border-tone { border-color: var(--line); } .text-balance { text-wrap: balance; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
    @stack('head')
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-black focus:px-4 focus:py-3 focus:text-white">Skip to content</a>
    <MarketingNavigation />
    <main id="main">@yield('content')</main>
    <footer class="paper border-t border-tone">
      <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
        <nav class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4" aria-label="Footer">
          <section>
            <h2 class="coral m-0 text-[11px] font-bold uppercase tracking-[0.18em]">Compare</h2>
            <ul class="m-0 mt-4 list-none space-y-2 p-0 text-sm">
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/mailchimp">vs Mailchimp</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/klaviyo">vs Klaviyo</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/kit">vs Kit</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/beehiiv">vs beehiiv</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/substack">vs Substack</a></li>
              <li><a class="ink font-semibold" href="/compare">All comparisons</a></li>
            </ul>
          </section>
          <section>
            <h2 class="coral m-0 text-[11px] font-bold uppercase tracking-[0.18em]">Compare more</h2>
            <ul class="m-0 mt-4 list-none space-y-2 p-0 text-sm">
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/hubspot">vs HubSpot</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/activecampaign">vs ActiveCampaign</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/brevo">vs Brevo</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/customer-io">vs Customer.io</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/birdeye">vs Birdeye</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/compare/podium">vs Podium</a></li>
            </ul>
          </section>
          <section>
            <h2 class="coral m-0 text-[11px] font-bold uppercase tracking-[0.18em]">Product</h2>
            <ul class="m-0 mt-4 list-none space-y-2 p-0 text-sm">
              <li><a class="muted hover:text-[var(--ink)]" href="/features">Features</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/solutions">Solutions</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/pricing">Pricing</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/integrations">Integrations</a></li>
            </ul>
          </section>
          <section>
            <h2 class="coral m-0 text-[11px] font-bold uppercase tracking-[0.18em]">Company</h2>
            <ul class="m-0 mt-4 list-none space-y-2 p-0 text-sm">
              <li><a class="muted hover:text-[var(--ink)]" href="/security">Security</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/privacy">Privacy</a></li>
              <li><a class="muted hover:text-[var(--ink)]" href="/terms">Terms</a></li>
            </ul>
          </section>
        </nav>
        <div class="mt-12 flex flex-col gap-3 border-t border-tone pt-6 sm:flex-row sm:items-center sm:justify-between">
          <a href="/" class="ink font-bold">CommsHQ</a>
          <p class="muted m-0 text-sm">Comparisons name other companies only to describe their products. All trademarks belong to their owners.</p>
          <p class="muted m-0 text-sm">Built with Stacks.</p>
        </div>
      </div>
    </footer>
    @stack('scripts')
  </body>
</html>
