<script server>
useSeoMeta({
  title: 'Sign in - CommsHQ',
  // Auth-walled, so there is nothing here worth indexing and a sign-in page in
  // search results is a phishing target with our name on it.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Uncontrolled inputs read from the submit event; only the states the page
// actually renders are signals. The token pack comes back as JSON AND as an
// httpOnly cookie, and it is the cookie the dashboard reads, so there is
// nothing for this page to persist.
const error: StxSignal<string> = state('')
const loading: StxSignal<boolean> = state(false)
// Two-factor step: revealed only when the account has TOTP enabled. The
// challenge token from step one and the "remember me" choice are carried in
// signals so step two can re-send them (the session tier must survive 2FA, and
// the challenge is single-use).
const twoFactor: StxSignal<boolean> = state(false)
const challengeToken: StxSignal<string> = state('')
const rememberChoice: StxSignal<boolean> = state(false)

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  loading.set(true)
  error.set('')
  try {
    const email = (form.elements.namedItem('email') as HTMLInputElement).value
    const password = (form.elements.namedItem('password') as HTMLInputElement).value
    const remember = (form.elements.namedItem('remember') as HTMLInputElement).checked
    const res = await fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ email, password, remember }),
    })
    const data = await res.json().catch(() => ({})) as Record<string, unknown>
    if (!res.ok) {
      // One message whatever the server said. Telling somebody that the address
      // is fine but the password is wrong turns this form into a way to find
      // out who has an account here.
      error.set('Incorrect email or password.')
      return
    }
    if (data.requires_two_factor === true) {
      // Reveal the code step. Keep the challenge token and the remember choice
      // so the second request completes the same session the user asked for.
      challengeToken.set(String(data.challenge_token ?? ''))
      rememberChoice.set(remember)
      twoFactor.set(true)
      return
    }
    navigate('/dashboard/commshq')
  }
  catch {
    error.set('Could not reach the server. Please try again.')
  }
  finally {
    loading.set(false)
  }
}

async function handleVerify(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  loading.set(true)
  error.set('')
  try {
    const code = (form.elements.namedItem('code') as HTMLInputElement).value.trim()
    const res = await fetch('/verify-two-factor-login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ challenge_token: challengeToken(), code, remember: rememberChoice() }),
    })
    const data = await res.json().catch(() => ({})) as Record<string, unknown>
    if (!res.ok) {
      // The challenge token is single-use, so a failed or expired attempt has
      // to restart from the password step rather than retry the code.
      error.set(String(data.message ?? 'That code did not work. Please sign in again.'))
      twoFactor.set(false)
      challengeToken.set('')
      return
    }
    navigate('/dashboard/commshq')
  }
  catch {
    error.set('Could not reach the server. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('auth')

@section('title', 'Sign in - CommsHQ')

@section('content')
<div class="max-w-sm w-full">
  <div class="mb-8 text-center">
    <StxLink to="/" class="font-bold text-2xl ink" style="text-decoration: none">CommsHQ</StxLink>
    <p class="mt-2 text-sm muted">Sign in to your workspace</p>
  </div>

  <div class="px-6 py-7 border rounded-2xl border-tone panel">
    <form @submit="handleSubmit" class="space-y-4" :show="!twoFactor()">
      <div>
        <label for="email" class="block mb-1.5 font-medium text-xs ink">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" class="field" placeholder="you@example.com">
      </div>
      <div>
        <label for="password" class="block mb-1.5 font-medium text-xs ink">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" class="field">
      </div>

      <label for="remember" class="flex items-center gap-2 text-xs muted" style="cursor: pointer">
        <input id="remember" name="remember" type="checkbox" class="rounded border-tone">
        Keep me signed in for 30 days
      </label>

      {{-- The label is static and the busy state rides on :disabled, an
          attribute binding. A reactive expression in the button's own text
          would make stx cloak it, and this button is the whole page. --}}
      <button type="submit" :disabled="loading()" class="px-4 py-2.5 w-full font-semibold text-sm text-[var(--coral-ink)] rounded-xl border-0 bg-coral" style="cursor: pointer">Sign in</button>
    </form>

    {{-- Second step for TOTP accounts. Hidden until step one reports
        requires_two_factor; the challenge token and remember choice ride in
        signals, so this form only needs the code. --}}
    <form @submit="handleVerify" class="space-y-4" :show="twoFactor()" style="display:none">
      <div>
        <label for="code" class="block mb-1.5 font-medium text-xs ink">Authentication code</label>
        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" placeholder="123456" class="field">
        <p class="mt-1 text-xs muted">Enter the 6-digit code from your authenticator app.</p>
      </div>
      <button type="submit" :disabled="loading()" class="px-4 py-2.5 w-full font-semibold text-sm text-[var(--coral-ink)] rounded-xl border-0 bg-coral" style="cursor: pointer">Verify</button>
    </form>

    <p class="mt-4 text-center text-xs muted" :show="loading()" style="display:none">Signing you in...</p>
    <p class="mt-4 px-3 py-2 text-sm text-center rounded-lg coral" :show="error()" style="display:none">{{ error() }}</p>
  </div>

  <p class="mt-6 text-center text-sm muted">
    No account yet?
    <StxLink to="/register" class="font-semibold ink">Create one</StxLink>
  </p>
</div>
@endsection
