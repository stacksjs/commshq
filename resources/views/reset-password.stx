<script server>
// Step two of a password reset: set the new one.
//
// This is the page config/auth.ts `passwordReset.url` points at. The two have
// to move together: if the URL names a page that does not exist, a valid token
// lands on a 404 and reads as a broken link rather than a misrouted one, so the
// person retries the same dead link instead of asking for a fresh one.
useSeoMeta({
  title: 'Set a new password - CommsHQ',
  description: 'Choose a new password for your CommsHQ account.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// POST /password/reset with the token the emailed link carried.
const error: StxSignal<string> = state('')
const done: StxSignal<boolean> = state(false)
const loading: StxSignal<boolean> = state(false)

const token: StxSignal<string> = state('')
const email: StxSignal<string> = state('')
// 'checking' until verify-token answers, then 'valid' or 'invalid'. The form is
// withheld until then: letting somebody pick and confirm a password against a
// dead token wastes the one thing they came here to do.
const linkState: StxSignal<string> = state('checking')

/** What /password/reset answers with. */
interface ResetResponse {
  message?: string
}

onMount(() => {
  const params = useSearchParams()
  const t = params.get('token') || ''
  const e = params.get('email') || ''
  token.set(t)
  email.set(e)

  if (!t || !e) {
    linkState.set('invalid')
    return
  }

  fetch('/password/verify-token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify({ token: t, email: e }),
  })
    // Only the action's own verdicts condemn a link: 400 for expired or already
    // used, 422 for malformed. A 5xx is this server failing, and `fetch` does
    // not reject on one, so `r.ok` alone tells people their link expired
    // whenever our own side is down, and sends them off to request another that
    // cannot arrive either. Offering the form instead costs nothing: the reset
    // re-verifies, so nothing is ever trusted on this answer.
    .then((r: Response) => { linkState.set(r.ok || r.status >= 500 ? 'valid' : 'invalid') })
    // Same for a transport failure, which is not a verdict at all.
    .catch(() => { linkState.set('valid') })
})

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return

  const form = e.target as HTMLFormElement
  const password = (form.elements.namedItem('password') as HTMLInputElement).value
  const confirmation = (form.elements.namedItem('password_confirmation') as HTMLInputElement).value

  // Both are re-checked server side. They are here so a typo answers at once
  // rather than spending a round trip, and so the message is about the field
  // rather than about the token.
  if (password !== confirmation) {
    error.set('Those two passwords do not match.')
    return
  }

  if (password.length < 8) {
    error.set('Use at least 8 characters.')
    return
  }

  loading.set(true)
  error.set('')

  try {
    const res = await fetch('/password/reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        email: email(),
        token: token(),
        password,
        password_confirmation: confirmation,
      }),
    })

    if (res.ok) {
      done.set(true)
      return
    }

    const data = await res.json().catch(() => ({})) as ResetResponse
    error.set(data.message || 'That reset link is not valid or has expired.')
  }
  catch {
    error.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('auth')

@section('title', 'Set a new password - CommsHQ')

@section('content')
<div class="max-w-sm w-full">
  <div class="mb-8 text-center">
    <StxLink to="/" class="font-bold no-underline text-2xl ink">CommsHQ</StxLink>
    <p class="mt-2 text-sm muted">Set a new password</p>
  </div>

  <div class="px-6 py-7 border border-tone rounded-2xl panel">
    <div :show="done()">
      {{-- No automatic redirect. The reset signs every other session out, so
           arriving at a sign-in form unannounced reads as the reset failing. --}}
      <p class="text-sm ink" role="status">Your password has been changed. You can sign in with it now.</p>
      <p class="mt-5 text-center text-xs muted">
        <StxLink to="/login" class="font-medium ink">Sign in</StxLink>
      </p>
    </div>

    <div :show="!done() && linkState() === 'checking'">
      <p class="text-sm muted">Checking your link.</p>
    </div>

    <div :show="!done() && linkState() === 'invalid'">
      <p class="text-sm ink">
        That link has expired. Reset links are good for 60 minutes and can only
        be used once.
      </p>
      <p class="mt-5 text-center text-xs muted">
        <StxLink to="/forgot-password" class="font-medium ink">Request a new link</StxLink>
      </p>
    </div>

    <form @submit="handleSubmit" class="space-y-4" :show="!done() && linkState() === 'valid'">
      <p class="text-sm muted">Choose something at least 8 characters long.</p>

      {{-- Present so a password manager knows which account it is saving
           against. The person cannot edit it; the token is bound to it. --}}
      <input type="hidden" name="email" :value="email()" autocomplete="username">

      <div>
        <label for="password" class="block mb-1.5 font-medium text-xs ink">New password</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class="field" :aria-invalid="error() ? 'true' : 'false'" :aria-describedby="error() ? 'reset-error' : ''">
      </div>

      <div>
        <label for="password_confirmation" class="block mb-1.5 font-medium text-xs ink">Confirm new password</label>
        <input id="password_confirmation" name="password_confirmation" type="password" required minlength="8" autocomplete="new-password" class="field" :aria-invalid="error() ? 'true' : 'false'" :aria-describedby="error() ? 'reset-error' : ''">
      </div>

      @if (error())
        <p id="reset-error" class="text-[var(--coral)] text-sm" role="alert">{{ error() }}</p>
      @endif

      <button type="submit" :disabled="loading()" :aria-busy="loading()" class="px-4 py-2.5 w-full font-semibold text-[var(--coral-ink)] text-sm bg-coral border-0 rounded-xl cursor-pointer">{{ loading() ? 'Saving' : 'Save new password' }}</button>
    </form>
  </div>
</div>
@endsection
