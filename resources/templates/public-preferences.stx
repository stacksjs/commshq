@extends('layouts/marketing')
@section('title', 'Communication preferences | CommsHQ')
@section('description', 'Choose which email and SMS updates you want to receive.')
@section('content')
  <section class="mx-auto px-5 py-20 sm:py-28 lg:px-8 max-w-3xl" aria-labelledby="preferences-title">
    <p class="font-bold text-xs tracking-[0.22em] uppercase coral">Preference center</p>
    <h1 id="preferences-title" class="mt-4 leading-tight text-5xl text-balance tracking-[-0.04em] sm:text-6xl ink">Choose what reaches you.</h1>
    <p class="mt-5 max-w-2xl leading-8 text-lg muted">A suppression always wins. Turning email back on requires confirmation, and turning SMS back on requires a START reply.</p>

    <form method="post" action="/preferences/{{ token }}" class="mt-10 p-5 space-y-4 sm:p-8 border border-tone rounded-2xl panel">
      @if(channels.email.available)
        <fieldset class="p-5 border border-tone rounded-xl">
          <legend class="px-2 font-bold ink">Email</legend>
          <p class="mt-1 text-sm muted">{{ contact.email }}</p>
          <div class="grid gap-3 sm:grid-cols-2 mt-4">
            <label class="flex gap-3 items-center px-4 min-h-12 border border-tone rounded-lg cursor-pointer ink"><input type="radio" name="email" value="enabled" @if(channels.email.enabled) checked @endif>Receive email</label>
            <label class="flex gap-3 items-center px-4 min-h-12 border border-tone rounded-lg cursor-pointer ink"><input type="radio" name="email" value="disabled" @if(!channels.email.enabled) checked @endif>Stop email</label>
          </div>
        </fieldset>
      @endif

      @if(channels.sms.available)
        <fieldset class="p-5 border border-tone rounded-xl">
          <legend class="px-2 font-bold ink">SMS</legend>
          <p class="mt-1 text-sm muted">{{ contact.phone }}</p>
          <div class="grid gap-3 sm:grid-cols-2 mt-4">
            <label class="flex gap-3 items-center px-4 min-h-12 border border-tone rounded-lg cursor-pointer ink"><input type="radio" name="sms" value="enabled" @if(channels.sms.enabled) checked @endif>Receive SMS</label>
            <label class="flex gap-3 items-center px-4 min-h-12 border border-tone rounded-lg cursor-pointer ink"><input type="radio" name="sms" value="disabled" @if(!channels.sms.enabled) checked @endif>Stop SMS</label>
          </div>
        </fieldset>
      @endif

      <button type="submit" class="px-6 min-h-12 w-full sm:w-auto font-bold text-white bg-coral rounded-md focus-visible:outline focus-visible:outline-[var(--coral)] focus-visible:outline-2 focus-visible:outline-offset-4">Save preferences</button>
    </form>
  </section>
