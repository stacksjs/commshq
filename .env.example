APP_NAME=CommsHQ
APP_ENV=development
NODE_ENV=development
APP_KEY=
APP_URL=commshq.localhost
APP_DOMAIN=commshq.org
APP_MAINTENANCE=false
APP_MAINTENANCE_SECRET=
APP_COMING_SOON=false
APP_COMING_SOON_SECRET=
DEBUG=true

# Generated by `buddy env:keypair`. Keep private keys out of git.
DOTENV_PUBLIC_KEY=
DOTENV_PRIVATE_KEY=

PORT=3030
PORT_API=3031

DB_CONNECTION=sqlite
DB_DATABASE_PATH=database/stacks.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=commshq
DB_USERNAME=commshq
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_VITESS_SHARDED=false

CACHE_DRIVER=memory
CACHE_PREFIX=commshq:cache
QUEUE_DRIVER=sync
QUEUE_FAILED_DRIVER=database
QUEUE_PREFIX=commshq:queue
QUEUE_CONCURRENCY=5
QUEUE_WORKER_CONCURRENCY=5
QUEUE_DLQ_ENABLED=true
QUEUE_DLQ_MAX_RETRIES=5
QUEUE_LOG_LEVEL=info

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_DOMAIN=commshq.org
MAIL_FROM_NAME=CommsHQ
MAIL_FROM_ADDRESS=hello@commshq.org
MAIL_DKIM_PUBLIC_KEY=

SMS_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_STRIPE_PUBLIC_KEY=

AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_PROFILE=stacks
AWS_S3_BUCKET=
AWS_S3_PREFIX=commshq

PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
HCLOUD_TOKEN=

FILESYSTEM_DISK=local
STORAGE_DRIVER=local
